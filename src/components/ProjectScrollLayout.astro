---
/**
 * ProjectScrollLayout.astro
 *
 * The standard for every RAMSLAB project page, built on the scroll-craft
 * engine (public/scrollcraft/, copied verbatim, never edited). Designed with
 * Demetra and the Skeleton Simulator as the reference pages.
 *
 * The standard:
 *   - black ground, white type, one accent colour per project
 *   - one continuous "world": the project's video plays (autoplay, loop) behind
 *     the whole story, and the scroll slowly walks the camera into it
 *   - opening: the title (always upper case) with the subtitle right under it is
 *     cut in two; the halves part and reveal the world
 *   - first section: the text in a black card, the media rising beside it over the world
 *   - next sections: black blocks, text card and media/3D model alternating sides;
 *     they enter the same way (label, text, then media) as soon as they are on screen
 *   - videos never follow the scroll: they autoplay in loop
 *   - 3D models animate on their own and can be turned by dragging
 *   - recap: description, and Publications / Funding always keep their place
 *
 * Usage:
 *   <ProjectScrollLayout
 *     title="DEMETRA" subtitle="..." accentColor="#22c55e"
 *     world={{ video: '/videos/scroll/demetra-world.mp4', poster: '...' }}   (optional)
 *     vision="..."                                                          (optional)
 *     sections={[
 *       { label, text, image: '/images/..' },            // image
 *       { label, text, video: '/videos/..' },            // video
 *       { label, text, model: '/models/x.glb', modelOptions: { build, anim, view, size } },
 *       { label, text },                                 // text only
 *     ]}
 *     description="..." publications={[...]} funding="..." team={[...]}
 *     prevActivity={{ label, href }} nextActivity={{ label, href }}
 *   />
 * Paths are site paths; the base path is added here.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { withBase } from '../lib/assets';

interface ModelOptions {
  build?: boolean;            // points → wireframe → solid entrance (default true)
  anim?: 'shears' | 'drive';  // shears: open/close swing · drive: the car follows the trajectory
  view?: 'side' | 'top';      // camera angle (default side; 'top' for flat models such as a track)
  size?: number;              // scale tweak (default 1)
}
interface Section {
  label: string;
  text: string;
  image?: string;
  imageAlt?: string;
  video?: string;
  poster?: string;
  videoLabel?: string;
  model?: string;
  modelOptions?: ModelOptions;
  mediaSide?: 'left' | 'right';   // black blocks: which side the media/model sits (default: alternating, starting right)
}
interface Publication { title: string; url: string; authors?: string; venue?: string; }
interface TeamMember { name: string; role: string; }
interface Props {
  title: string;
  subtitle?: string;
  accentColor?: string;
  world?: { video?: string; poster?: string; image?: string };
  vision?: string;
  sections: Section[];
  description: string;
  publications?: Publication[];
  funding?: string;
  team?: TeamMember[];
  prevActivity?: { label: string; href: string };
  nextActivity?: { label: string; href: string };
}

const {
  title, subtitle, accentColor = '#22c55e', world, vision, sections,
  description, publications = [], funding, team = [], prevActivity, nextActivity,
} = Astro.props;

const b = (p?: string) => (p ? withBase(p) : undefined);
// title size follows its length so short and long titles both fill the opening
const titleSize = title.length <= 10 ? 'xl' : title.length <= 40 ? 'lg' : 'md';
const longSubtitle = (subtitle ?? '').length > 60;
const [first, ...rest] = sections;
---

<BaseLayout title={`${title} — Immersive Experience`}>
  <link rel="stylesheet" href={withBase('/scrollcraft/scrollcraft.css')} />
  <div class="project-page-layout ps" style={`--accent: ${accentColor};`}>
    <Header />
    <span data-sc-progress></span>

    <!-- THE WORLD · always playing, always behind; the scroll walks into it -->
    <div class="ps-world" aria-hidden="true">
      {world?.video
        ? <video src={b(world.video)} poster={b(world.poster)} autoplay muted loop playsinline preload="auto"></video>
        : world?.image && <img src={b(world.image)} alt="" />}
      <div class="ps-world-light"></div>
    </div>

    <main id="main-content" class="ps-main">

      <!-- OPENING · title and subtitle are cut in two and the halves part -->
      <section class="ps-hero" data-ps data-sc-act="pin" data-sc-span="2.4" aria-labelledby="ps-title">
        <div data-sc-stage class="ps-st ps-hero-st">
          <h1 id="ps-title" class="sr-only">{title}</h1>
          {subtitle && <p class="sr-only">{subtitle}</p>}
          {['top', 'bot'].map((half) => (
            <div class={`ps-half ps-half--${half}`} aria-hidden="true">
              <div class="ps-word">
                <div class="ps-head">
                  <span class={`ps-title ps-title--${titleSize}`}>{title}</span>
                  {subtitle && <p class={`ps-sub ${longSubtitle ? 'ps-sub--long' : ''}`}>{subtitle}</p>}
                </div>
              </div>
            </div>
          ))}
          <span class="ps-slash" aria-hidden="true"></span>
          {vision && <div class="ps-card ps-vision"><p>{vision}</p></div>}
        </div>
      </section>

      <!-- FIRST SECTION · text card, the media rises beside it over the world -->
      {first && (
        <section class="ps-rise" data-ps data-sc-act="pin" data-sc-span="2.6" aria-labelledby="ps-s0">
          <div data-sc-stage class="ps-st ps-rise-st">
            <div class="ps-card ps-rise-text">
              <h2 id="ps-s0" class="ps-label">{first.label}</h2>
              <p class="ps-lede">{first.text}</p>
            </div>
            {(first.image || first.video) && (
              <figure class="ps-rise-media">
                {first.video
                  ? <video src={b(first.video)} poster={b(first.poster)} autoplay muted loop playsinline preload="auto" aria-label={first.videoLabel ?? first.label}></video>
                  : <img src={b(first.image)} alt={first.imageAlt ?? ''} />}
              </figure>
            )}
          </div>
        </section>
      )}

      <!-- NEXT SECTIONS · black blocks, text and media/model alternating sides -->
      {rest.map((s, i) => {
        const side = s.mediaSide ?? (i % 2 === 0 ? 'right' : 'left');
        const flip = side === 'left';
        const id = `ps-s${i + 1}`;
        const opts = s.modelOptions ?? {};
        return (
          <section class={`ps-block ${flip ? 'ps-block--flip' : ''} ${!s.model && !s.image && !s.video ? 'ps-block--text' : ''}`} data-ps data-sc-act="pin" data-sc-span="2.6" aria-labelledby={id}>
            <div data-sc-stage class="ps-st ps-block-st">
              {s.model && (
                <div class="ps-view ps-model" data-model={b(s.model)} data-build={opts.build === false ? '0' : '1'}
                  data-anim={opts.anim ?? ''} data-view={opts.view ?? 'side'} data-size={opts.size ?? 1}></div>
              )}
              {!s.model && (s.image || s.video) && (
                <div class="ps-view ps-view--media">
                  {s.video
                    ? <video src={b(s.video)} poster={b(s.poster)} autoplay muted loop playsinline preload="auto" aria-label={s.videoLabel ?? s.label}></video>
                    : <img src={b(s.image)} alt={s.imageAlt ?? ''} loading="lazy" />}
                </div>
              )}
              <div class="ps-card ps-block-text">
                <h2 id={id} class="ps-label">{s.label}</h2>
                <p class="ps-lede">{s.text}</p>
              </div>
            </div>
          </section>
        );
      })}

      <!-- RECAP · description; Publications, Team and Funding only when present -->
      <section class="ps-recap">
        <div class="container">
          <div class="ps-info" data-sc-in>
            <div class="ps-info-grid">
              <div>
                <h2 class="ps-info-label">Description</h2>
                <p class="ps-info-description">{description}</p>
              </div>
              <div>
                {publications.length > 0 && (
                <div class="ps-info-group">
                  <h3 class="ps-info-label">Publications</h3>
                  <div class="dense-list">
                    {publications.map((pub) => (
                      <article class="ps-pub">
                        <div class="text-list-title"><a href={pub.url} target="_blank" rel="noopener noreferrer" class="hover-underline">{pub.title}</a></div>
                        {pub.authors && <div class="text-list-meta">{pub.authors}</div>}
                        {pub.venue && <div class="text-emphasis">{pub.venue}</div>}
                      </article>
                    ))}
                  </div>
                </div>
                )}
                {team.length > 0 && (
                  <div class="ps-info-group">
                    <h3 class="ps-info-label">Team</h3>
                    <ul class="ps-team">
                      {team.map((m) => <li><strong>{m.name}</strong> · {m.role}</li>)}
                    </ul>
                  </div>
                )}
                {funding && (
                  <div class="ps-info-group">
                    <h3 class="ps-info-label">Funding</h3>
                    <p class="ps-funding">{funding}</p>
                  </div>
                )}
              </div>
            </div>
            <footer class="ps-info-footer">
              {prevActivity ? <a href={b(prevActivity.href)} class="ps-nav">← <span>Previous Activity</span></a> : <span></span>}
              {nextActivity ? <a href={b(nextActivity.href)} class="ps-nav"><span>Next Activity</span> →</a> : <span></span>}
            </footer>
          </div>
        </div>
      </section>
    </main>
    <div class="ps-foot"><Footer /></div>
  </div>

  <script is:inline src={withBase('/scrollcraft/scrollcraft.js')}></script>
  <script is:inline>
    ScrollCraft.mount(document.body);
    (function () {
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      // black blocks: mark each one "in" once it is well on screen (once)
      var blocks = [].slice.call(document.querySelectorAll('.ps-block'));
      function check() {
        blocks.forEach(function (bl) {
          if (!bl.classList.contains('is-in') && bl.getBoundingClientRect().top < innerHeight * 0.45) bl.classList.add('is-in');
        });
      }
      window.addEventListener('scroll', check, { passive: true });
      check();
      // the walk: progress through the story drives the camera into the world
      var root = document.querySelector('.ps');
      var acts = [].slice.call(document.querySelectorAll('[data-ps]'));
      if (!root || !acts.length) return;
      var firstAct = acts[0], lastAct = acts[acts.length - 1];
      (function tick() {
        var top = firstAct.offsetTop, end = lastAct.offsetTop + lastAct.offsetHeight - innerHeight;
        var w = reduce ? 0 : Math.max(0, Math.min(1, (scrollY - top) / Math.max(1, end - top)));
        root.style.setProperty('--w', w.toFixed(4));
        requestAnimationFrame(tick);
      })();
    })();
  </script>

  <script>
    /* 3D models: they animate on their own (never driven by the scroll) and can
       be turned by dragging. Every model is centred and framed from its own size. */
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    async function initModels() {
      const boxes = Array.from(document.querySelectorAll<HTMLElement>('.ps-model'));
      if (!boxes.length) return;
      try {
        const THREE = await import('three');
        const { GLTFLoader } = await import('three/examples/jsm/loaders/GLTFLoader.js');
        const { OrbitControls } = await import('three/examples/jsm/controls/OrbitControls.js');
        const { RoomEnvironment } = await import('three/examples/jsm/environments/RoomEnvironment.js');
        const { default: gsap } = await import('gsap');
        const accentCss = getComputedStyle(document.querySelector('.ps')!).getPropertyValue('--accent').trim() || '#22c55e';

        boxes.forEach((box) => {
          const build = box.dataset.build === '1';
          const shears = box.dataset.anim === 'shears';
          const drive = box.dataset.anim === 'drive';
          const top = box.dataset.view === 'top';
          const sizeTweak = parseFloat(box.dataset.size || '1') || 1;

          const scene = new THREE.Scene();
          const camera = new THREE.PerspectiveCamera(40, 1, 0.1, 5000);
          const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
          renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
          box.appendChild(renderer.domElement);
          scene.environment = new THREE.PMREMGenerator(renderer).fromScene(new RoomEnvironment(), 0.04).texture;
          scene.add(new THREE.AmbientLight(0xffffff, 0.8));
          const sun = new THREE.DirectionalLight(0xffffff, 2); sun.position.set(4, 10, 6); scene.add(sun);

          const controls = new OrbitControls(camera, renderer.domElement);
          controls.enableDamping = true; controls.dampingFactor = 0.06;
          controls.enablePan = false; controls.enableZoom = false;
          controls.minPolarAngle = top ? 0.5 : Math.PI / 2.4;
          controls.maxPolarAngle = top ? 1.25 : Math.PI / 1.7;
          controls.autoRotate = !reduce && !shears && !drive; controls.autoRotateSpeed = 0.8;
          renderer.domElement.style.touchAction = 'pan-y';

          const group = new THREE.Group(); scene.add(group);
          const points = new THREE.Group(), wire = new THREE.Group(), solid = new THREE.Group();
          group.add(points, wire, solid);
          let radius = 5, blade: any = null, trigger: any = null;
          let car: any = null, path: any = null, carLift = 0;

          // camera distance from the model's size and the box shape, so nothing is cut
          const frame = (far = 1) => {
            const w = box.clientWidth || 1, h = box.clientHeight || 1;
            camera.aspect = w / h; camera.updateProjectionMatrix(); renderer.setSize(w, h);
            const fitH = radius / Math.sin((camera.fov * Math.PI) / 360);
            const dist = fitH * Math.max(1, 1 / camera.aspect) * far / sizeTweak;
            if (top) camera.position.set(0, dist * 0.62, dist * 0.82); else camera.position.set(0, radius * 0.05, dist);
          };

          let visible = false, loaded = false;
          new IntersectionObserver((es) => es.forEach((e) => {
            visible = e.isIntersecting;
            if (visible && !loaded) { loaded = true; load(); }
          }), { threshold: 0.2 }).observe(box);

          function load() {
            new GLTFLoader().load(box.dataset.model!, (gltf) => {
              const model = gltf.scene;
              const bb = new THREE.Box3().setFromObject(model);
              const center = bb.getCenter(new THREE.Vector3());
              const size = bb.getSize(new THREE.Vector3());
              const k = 10 / Math.max(size.x, size.y, size.z);
              radius = size.clone().multiplyScalar(k).length() / 2;
              const accent = new THREE.Color(accentCss);

              if (build) {
                model.traverse((child: any) => {
                  if (!child.isMesh) return;
                  child.updateMatrixWorld();
                  const geo = child.geometry.clone(); geo.applyMatrix4(child.matrixWorld);
                  points.add(new THREE.Points(geo, new THREE.PointsMaterial({ color: accent, size: 0.03, transparent: true, opacity: 0 })));
                  wire.add(new THREE.Mesh(geo, new THREE.MeshBasicMaterial({ color: accent, wireframe: true, transparent: true, opacity: 0 })));
                  const fin = child.clone(false); fin.geometry = geo; fin.position.set(0, 0, 0); fin.rotation.set(0, 0, 0); fin.scale.set(1, 1, 1);
                  const mk = (m: any) => { const n = m.clone(); n.transparent = true; n.opacity = 0; return n; };
                  fin.material = Array.isArray(fin.material) ? fin.material.map(mk) : mk(fin.material);
                  solid.add(fin);
                });
              } else {
                model.traverse((child: any) => {
                  const n = (child.name || '').toLowerCase();
                  if (n.includes('blade') && !blade) blade = child;
                  if (n.includes('trigger') && !trigger) trigger = child;
                  const m = child.material;
                  if (shears && child.isMesh && m instanceof THREE.MeshStandardMaterial) { m.metalness = 0.9; m.roughness = 0.2; m.envMapIntensity = 1; m.needsUpdate = true; }
                });
                solid.add(model);
                if (drive) {
                  // the car drives along the trajectory strip: its centre line is found by
                  // averaging the strip's vertices in slices along its length
                  model.updateMatrixWorld(true);
                  let strip: any = null;
                  model.traverse((c: any) => {
                    const n = (c.name || '').toLowerCase();
                    if (!car && n.includes('player_car')) car = c;
                    if (!strip && c.isMesh && n.includes('curve')) strip = c;
                  });
                  if (car && strip) {
                    const pos = strip.geometry.attributes.position, v = new THREE.Vector3();
                    const pts: any[] = [];
                    for (let i = 0; i < pos.count; i++) pts.push(v.fromBufferAttribute(pos, i).applyMatrix4(strip.matrixWorld).clone());
                    const sb = new THREE.Box3().setFromPoints(pts), ss = sb.getSize(new THREE.Vector3());
                    const ax = ss.x > ss.z ? 'x' : 'z', lo = (sb.min as any)[ax], span = (ss as any)[ax];
                    const N = 24, sum = Array.from({ length: N }, () => new THREE.Vector3()), cnt = new Array(N).fill(0);
                    pts.forEach((p) => { const b = Math.min(N - 1, Math.floor(((p as any)[ax] - lo) / span * N)); sum[b].add(p); cnt[b]++; });
                    const line = sum.filter((_, i) => cnt[i]).map((p, i) => p.divideScalar(cnt.filter(Boolean)[i]));
                    const cb = new THREE.Box3().setFromObject(car), cc = cb.getCenter(new THREE.Vector3());
                    // start from the end of the strip nearest to the car
                    if (line[0].distanceTo(cc) > line[line.length - 1].distanceTo(cc)) line.reverse();
                    path = new THREE.CatmullRomCurve3(line);
                    model.attach(car);
                    carLift = car.position.y;
                    const q = car.quaternion.clone(); car.rotation.set(0, 0, 0);
                    car.userData.q0 = q; car.userData.off = cc.sub(car.position).setY(0);
                  }
                }
              }
              group.scale.setScalar(k);
              group.position.copy(center).multiplyScalar(-k);
              if (shears) group.rotation.x = Math.PI / 12;

              frame(build ? 0.8 : 1);
              if (build) {
                const mats = (g: any, test: (o: any) => boolean) => { const out: any[] = []; g.traverse((c: any) => { if (test(c)) out.push(...([] as any[]).concat(c.material)); }); return out; };
                const pM = mats(points, (c) => c.isPoints), wM = mats(wire, (c) => c.isMesh), fM = mats(solid, (c) => c.isMesh);
                const end = camera.position.clone().multiplyScalar(1.25);
                const tl = gsap.timeline({ paused: true });
                tl.to(camera.position, { x: end.x, y: end.y, z: end.z, duration: 8, ease: 'power1.inOut' }, 0);
                tl.to(pM, { opacity: 1, duration: 2.5, stagger: 0.1 }, 0);
                tl.to(wM, { opacity: 0.3, duration: 2.5, stagger: 0.1 }, 1.5);
                tl.to(fM, { opacity: 1, duration: 4, stagger: 0.15 }, 3.5);
                tl.to([...pM, ...wM], { opacity: 0.1, duration: 3 }, 5);
                if (reduce) tl.progress(1); else tl.play();
              }
            });
          }

          frame();
          const t0 = performance.now();
          (function tick() {
            requestAnimationFrame(tick);
            if (!visible) return;
            if (shears) {
              const t = (performance.now() - t0) / 1000;
              const close = reduce ? 0 : Math.pow((1 - Math.cos(t * Math.PI * 2 / 2.6)) / 2, 2);
              if (blade) blade.rotation.z = -close * (Math.PI / 3.5);
              if (trigger) trigger.rotation.z = -close * (Math.PI / 7);
              // swing around the side profile, never far enough to show the shears end-on
              solid.rotation.y = reduce ? 0 : Math.sin(t * 0.45) * 0.5;
            }
            if (drive && path && car) {
              // drive for 7 s, wait a beat at the finish, then start again
              const t = (performance.now() - t0) / 1000 % 9;
              const e = reduce ? 0 : Math.min(1, t / 7);
              const u = e * e * (3 - 2 * e);
              const p = path.getPointAt(u), d = path.getTangentAt(Math.min(0.999, Math.max(0.001, u)));
              const t0d = path.getTangentAt(0.001);
              const yaw = Math.atan2(d.x, d.z) - Math.atan2(t0d.x, t0d.z);
              car.quaternion.setFromAxisAngle(new THREE.Vector3(0, 1, 0), yaw).multiply(car.userData.q0);
              const off = car.userData.off.clone().applyAxisAngle(new THREE.Vector3(0, 1, 0), yaw);
              car.position.set(p.x - off.x, carLift, p.z - off.z);
            }
            controls.update();
            renderer.render(scene, camera);
          })();
          window.addEventListener('resize', () => frame(build ? 1 : 1));
        });
      } catch (e) {
        console.error('Three.js failed to load:', e);
      }
    }
    initModels();
  </script>

  <style is:global>
    .ps, body:has(.ps) {
      --sc-canvas: #000; --sc-surface: #0d0d0d; --sc-ink: #fff; --sc-ink-soft: rgb(255 255 255 / 0.75);
      --sc-accent: var(--accent); --sc-accent-ink: #000;
      --sc-font-display: var(--font-sans); --sc-font-text: var(--font-sans); --sc-font-mono: var(--font-sans);
      --ps-top: 72px;
      --w: 0;
    }
    body:has(.ps) { background: #000; font-size: 1rem; line-height: 1.45; letter-spacing: normal; }
    html:has(.ps) { background: #000; scroll-behavior: auto; }
    .ps [data-sc-progress] { background: var(--accent); }
    .ps-main { position: relative; z-index: 1; color: #fff; font-family: var(--font-sans); }
    .ps-st { --p: var(--sc-p, 0); background: transparent; overflow: hidden; }

    /* ── the world ── */
    .ps-world { position: fixed; inset: 0; z-index: 0; overflow: hidden; background: #000; }
    .ps-world video, .ps-world img { width: 100%; height: 100%; object-fit: cover; display: block; max-width: none;
      transform: scale(calc(1.06 + var(--w) * 0.5)) translateY(calc(var(--w) * -3%)); transform-origin: 50% 60%; }
    .ps-world-light { position: absolute; inset: 0; background: radial-gradient(circle at center, rgb(0 0 0 / 0.15), rgb(0 0 0 / 0.7)); }

    /* ── shared type ── */
    .ps-label { margin: 0 0 1.1rem; font-size: 0.8125rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--accent); }
    .ps-lede { margin: 0; font-size: clamp(1.2rem, 1.75vw, 1.75rem); line-height: 1.3; font-weight: 500; letter-spacing: -0.012em; }
    .ps-card { background: #000; color: #fff; padding: clamp(1.5rem, 2.6vw, 2.5rem); box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.8); }

    /* ═══ opening ═══ */
    .ps-hero-st {
      --slash: clamp(0, (var(--p) - 0.02) / 0.12, 1);
      --o: clamp(0, (var(--p) - 0.16) / 0.42, 1);
      --open: calc(var(--o) * var(--o) * (3 - 2 * var(--o)));
    }
    .ps-half { position: absolute; left: 0; right: 0; z-index: 2; height: 50%; overflow: hidden; background: #000; }
    .ps-half--top { top: 0; transform: translateY(calc(var(--open) * -118%)) rotate(calc(var(--open) * -3deg)); transform-origin: 0 100%; }
    .ps-half--bot { bottom: 0; transform: translateY(calc(var(--open) * 118%)) rotate(calc(var(--open) * 2deg)); transform-origin: 100% 0; }
    .ps-word { position: absolute; left: 0; right: 0; height: 200%; display: grid; place-items: center; }
    .ps-half--top .ps-word { top: 0; }
    .ps-half--bot .ps-word { bottom: 0; }
    .ps-head { display: grid; justify-items: center; gap: clamp(1rem, 2.4vh, 1.75rem); text-align: center; padding: 0 var(--pad); }
    .ps-title { display: block; font-weight: 900; text-transform: uppercase; letter-spacing: normal; color: var(--accent); text-align: center; }
    .ps-title--xl { font-size: clamp(4.5rem, 16.5vw, 17rem); line-height: 0.8; }
    .ps-title--lg { font-size: clamp(2.6rem, 6.2vw, 6.8rem); line-height: 0.95; max-width: 16ch; }
    .ps-title--md { font-size: clamp(2.2rem, 4.6vw, 5rem); line-height: 0.98; max-width: 22ch; }

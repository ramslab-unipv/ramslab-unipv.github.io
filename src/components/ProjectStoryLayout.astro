    .pd-dual--one .pd-dual-lead { max-width: 52rem; font-size: clamp(1.8rem, 3.2vw, 3.2rem); line-height: 1.12; font-weight: 700; letter-spacing: -0.025em; }
    @media (prefers-reduced-motion: no-preference) {
      .pd-dual-line[data-sc-in] { opacity: 1; transform: scaleY(0); transition: transform 1400ms var(--sc-ease-out); }

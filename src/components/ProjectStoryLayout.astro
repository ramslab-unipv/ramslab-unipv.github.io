    .pd-card-meta { color: var(--muted); font-size: 0.75rem; margin-top: 4px; line-height: 1.4; }
    .pd-card-team { list-style: none; padding: 0; margin: 0; }
    .pd-card-team li { padding: 12px 0; border-top: 1px solid rgb(0 0 0 / 0.05); font-size: 1rem; color: #334155; }
    .pd-card-funding { font-size: 1rem; line-height: 1.5; color: #333; margin: 0; }
    .pd-cap { text-transform: capitalize; }
    .pd-venue { font-style: italic; }
    .pd-card-footer { margin-top: 60px; padding-top: 32px; border-top: 1px solid rgb(0 0 0 / 0.08); display: flex; justify-content: space-between; }
    .pd-card-nav { color: #666; text-decoration: none; font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.1em; font-weight: 700; transition: color 0.2s ease; }
    .pd-card-nav:hover { color: #000; text-decoration: underline; text-underline-offset: 0.2em; }

    @media (max-width: 768px) {
      .pd, body:has(.pd) { --pd-top: 64px; }

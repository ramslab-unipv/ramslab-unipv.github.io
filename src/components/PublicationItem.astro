---
import { formatPublicationDetails } from '../lib/publications';

interface Props {
  title: string;
  authors: string[];
  year: number;
  venue?: string;
  url: string;
}

const { title, authors, year, venue, url } = Astro.props;
---

<article class="dense-item">
  <div class="text-list-title" style="color: var(--text);">
    <a href={url} target="_blank" rel="noopener noreferrer" style="color: inherit; text-decoration: none;" class="hover-underline">{title}</a>
  </div>
  <div class="text-list-meta" style="color: var(--muted);">{authors.join(', ')}</div>
  <div class="text-emphasis" style="color: var(--muted);">{formatPublicationDetails({ venue, year })}</div>
</article>

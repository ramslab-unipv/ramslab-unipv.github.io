---
/*
  About 4: the RAMSLAB story as defined in Contents.docx (Hero, What we do,
  Human centric robotics, Human in the loop, Lab facilities, Long-term vision),
  built on the scroll-craft engine (public/scrollcraft/, copied verbatim,
  never edited). All white, in the site's own style: the page header and the
  activity cards are the same as /activities/.

  HCR VIDEO SLOT: the Human centric robotics scene mirrors the Human in the
  loop scene and keeps an empty media slot (.a4-media--placeholder). When the
  clip is ready, encode it like hitl.mp4 (public/videos/about_4/) and replace
  the placeholder with a <video data-scrub data-src=... data-src-mobile=...>
  like the one in the HITL scene; the page script scrubs any [data-scrub]
  video inside a scene from that scene's own progress.

  Scrubbed clips carry data-scrub so BaseLayout's autoplay skips them.
*/
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import RelatedRail from '../components/RelatedRail.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/assets';
import { entrySlug } from '../lib/entries';
import site from '../content/settings/site.json';
/* Google Material Symbols (outlined), downloaded from fonts.gstatic.com */
import icMemory from '../assets/icons/memory.svg?raw';
import icRobot from '../assets/icons/precision_manufacturing.svg?raw';
import icHmd from '../assets/icons/head_mounted_device.svg?raw';
import icCube from '../assets/icons/deployed_code.svg?raw';

const v4 = (name: string) => withBase(`/videos/about_4/${name}`);

/* ── Activity cards: same data and routing as /activities/ ── */
const routes: Record<string, string> = {
  'demetra-nodes': '/activities/demetra/',
  'dynamica': '/activities/dynamica/',
  'air-flow-dynamic': '/activities/air-flow-dynamic/',
  'robotic-liquid-handling': '/activities/robotic-liquid-handling/',
  'human-centric-skeleton-simulator': '/activities/human-centric-skeleton-simulator/',
  'ahbi': '/activities/ahbi/',
  'drivesim': '/activities/drivesim/',
  'balance-platform-simulator': '/activities/balance-platform-simulator/',
  '3d-human-poses-estimation': '/activities/3d-human-poses-estimation/',
};
const all = await getCollection('activities', ({ data }) => !data.draft);
const pick = (slugs: string[]) =>
  slugs
    .map((s) => all.find((a) => entrySlug(a.id) === s))
    .filter(Boolean)
    .map((a) => {
      const slug = entrySlug(a!.id);
      return {
        href: routes[slug] ? withBase(routes[slug]) : null,
        title: a!.data.title,
        /* same data as the homepage card: real cover, fit, year · status; ProjectCard adds the base path */
        cover: a!.data.cover,
        fit: a!.data.coverFit as 'cover' | 'contain' | undefined,
        meta: [a!.data.year?.toString(), a!.data.status?.replace(/ongoing/i, 'ONGOING')].filter(Boolean).join(' · '),
      };
    });
const hcrActivities = pick(['air-flow-dynamic', 'robotic-liquid-handling', 'dynamica', 'carbon-fiber', 'fiber-placement']);
const hitlActivities = pick(['human-centric-skeleton-simulator', '3d-human-poses-estimation', 'drivesim', 'balance-platform-simulator', 'demetra-nodes', 'ahbi']);

/* ── Scenes: pillars share one timing scheme, all finished by 0.8 ── */
const hcrPillars = [
  ['Ultimate Human Tool', 'The robot as the ultimate extension of human capability', 'Tool'],
  ['Democratizing Robotics', 'Making robotic technology accessible to all', 'Access'],
  ['Unlocking Creativity', 'Enabling creative thinking within production processes', 'Create'],
  ['Reduce Repetitive Tasks', 'Freeing workers from monotonous, repetitive work', 'Free'],
  ['No Code Approach', 'Intuitive interfaces requiring no programming knowledge', 'No code'],
  ['Agentic Framework', 'Human/machine interface driven by agentic systems', 'Agents'],
  ['Physical AI', 'Intelligent systems embedded in the physical world', 'Physical'],
];
const hitlPillars = [
  ['Zero-Risk Validation', 'Safety and Comfort validation in a controlled, consequence-free environment.'],
  ['Mapping Human Behaviour', 'Capturing and modelling real human motion and decision patterns.'],
  ['Testing of Devices', 'Rigorous evaluation of devices within a fully controlled environment.'],
  ['Cognitive Load Assessment', 'Measuring mental effort to ensure intuitive and ergonomic human-robot interaction.'],
];
/* pillar i of n is on screen from at(i) to at(i+1); the first is there on arrival */
const at = (i: number, n: number) => (i === 0 ? -1 : (i / n) * 0.8).toFixed(3);

/* The HITL clip shows five simulators in sequence; times are clip seconds. */
const devices = [
  { word: 'Pruning', from: 0 },
  { word: 'Cycling', from: 2.3 },
  { word: 'Skeleton', from: 5.1 },
  { word: 'Driving', from: 7.4 },
  { word: 'Balance', from: 9.7 },
];

const facilities = [
  { title: 'Computing Infrastructure', icon: icMemory,
    items: ['Workstations and computing servers', 'NAS systems for data storage and processing', 'GPU clusters: 8× NVIDIA RTX 3090, 6× NVIDIA RTX 4080, 3× NVIDIA RTX 4090', 'Edge computing: NVIDIA Jetson Orin & Nano, Raspberry Pi 5'] },
  { title: 'Robotic Systems', icon: icRobot,
    items: ['Mitsubishi RV-5-AS-D', 'Mitsubishi RV-8CRL-D-S15', 'Mitsubishi RV-2FRB-D-S25', 'Omron TM12', 'Omron TM5', 'Dobot CR10AS', 'Kawasaki MC004N'] },
  { title: 'Simulation & Testing Equipment', icon: icHmd,
    items: ['Hexapod motion platform with 8m curved immersive display', '6-DoF force platform', 'Real-time optical and markerless motion capture system', 'Driving simulator', 'Balance board', 'Pharmaceutical isolator', 'Infinadeck omnidirectional treadmill'] },
  { title: 'Manufacturing & Prototyping', icon: icCube,
    items: ['3D prototyping', 'CO2 Laser cutting', 'Optical table for precision measurement setup'] },
];

/* What we do: text only, from Contents.docx */
const whatWeDo = [
  { title: 'Human centric robotics', href: '#hcr', loop: 'what-hcr',
    text: 'Robotics as a system to enhance human capabilities, designed to combine quality, flexibility, and worker safety within production processes that cannot be fully standardized.' },
  { title: 'Human in the loop', href: '#hitl', loop: 'what-hitl',
    text: "Integrates operators into the production system's observation and decision-making cycle, converting human behavior into actionable data to evaluate functionality, efficiency, and safety." },
];

const longTerm = 'Instead of programming robot motions, the operator will simply specify the product to manufacture, while the system determines how to accomplish the task.';
---

<BaseLayout title={`About — ${site.siteTitle}`} description="Welcome to RAMSLAB, where human intuition meets robotic innovation: human-centric robotics and human-in-the-loop simulation at the University of Pavia.">
  <link rel="stylesheet" href={withBase('/scrollcraft/scrollcraft.css')} />
  <div class="a4">
  <Header />
  <span data-sc-progress></span>

  <main id="main-content" class="projects-page-main a4-main">

    <!-- ─── Page header, as on every other page ─── -->
    <section class="projects-header-section">
      <div class="projects-header-container">
        <div class="projects-header-content a4-pagehead">
          <h1 class="projects-title-big">About RAMSLAB</h1>
          <p class="text-link-header a4-motto">{site.siteMotto}</p>
        </div>
      </div>
    </section>

    <!-- ═══ 1 · HERO · the RAMSLAB mark is a person: it draws itself, then we step into its head ═══ -->
    <section class="a4-act a4-hero" data-a4 data-sc-act="pin" data-sc-span="2.5" aria-labelledby="a4-hero-t">
      <div data-sc-stage class="a4-st a4-hero-st">
        <p class="text-heading-2 a4-hero-k">Welcome to RAMSLAB</p>
        <h2 id="a4-hero-t" class="a4-hero-grid">
          <span class="a4-hero-l">Where human intuition</span>
          <svg class="a4-mark" viewBox="-1 -1 32 32" aria-hidden="true">
            <path class="a4-mark-body" pathLength="1" d="M29.6472 29.6504C29.6472 29.6504 29.5272 23.2262 29.5233 21.7608C29.5188 21.7608 29.5143 21.7608 29.5091 21.7608C24.8497 22.0872 14.7858 19.4446 14.7858 14.9613C14.7858 7.58898 29.5227 7.57479 29.5227 7.57479L29.5085 0.0954281C29.5085 0.0954281 23.9938 0.0257687 22.1575 0.0954281C10.2612 0.548214 10.5566 11.0139 11.2248 14.5433C11.6131 16.5963 12.6083 19.1976 14.3027 21.6608L7.41999 21.6989C2.57415 21.8247 -0.393476 26.199 0.0406056 29.8252L7.36388 29.7678C7.36388 29.7678 7.60704 22.6586 14.7845 22.3316C17.7393 26.2725 22.5574 29.6859 29.6465 29.6504H29.6472Z" />
            <circle class="a4-mark-head" cx="3.735" cy="7.575" r="3.693" />
          </svg>
          <span class="a4-hero-r">meets <em>robotic innovation.</em></span>
        </h2>
      </div>
    </section>

    <!-- ═══ 2 · WHAT WE DO · split screen: looping animation left, title + definition right; the two slides travel sideways ═══ -->
    <section class="a4-act a4-what" data-a4 data-sc-act="pin" data-sc-span="4.4" aria-labelledby="a4-what-t">
      <div data-sc-stage class="a4-st a4-what-st">
        <h2 id="a4-what-t" class="chapter-label text-heading-2 a4-label a4-what-k">What we do</h2>
        <div class="a4-track">
          {whatWeDo.map((w, k) => {
            const words = w.title.split(' ');
            const n = w.title.replace(/ /g, '').length;
            let ci = 0;
            const textWords = w.text.split(' ');
            return (
              <article class={`a4-wp a4-wp--${k}`}>
                <div class="a4-wp-media">
                  <video class="a4-wp-video" src={v4(`${w.loop}.mp4`)} poster={v4(`${w.loop}-poster.jpg`)} autoplay muted loop playsinline preload="auto" aria-hidden="true"></video>
                </div>
                <div class="a4-wp-copy">
                  <h3 class="a4-wp-title" aria-label={w.title}>
                    {words.map((word) => (
                      <span class="a4-wp-word" aria-hidden="true">
                        {word.split('').map((ch) => <span class="a4-ch" style={`--i:${(ci++ / n).toFixed(3)}`}>{ch}</span>)}
                      </span>
                    ))}
                  </h3>
                  <p class="a4-wp-text">{textWords.map((t, j) => <span class="a4-tw" style={`--j:${(j / textWords.length).toFixed(3)}`}>{t} </span>)}</p>
                  <a href={w.href} class="text-heading-2 a4-more">The vision <span aria-hidden="true">➞</span></a>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <!-- ═══ 3 · HUMAN CENTRIC ROBOTICS · scene, video slot reserved ═══ -->
    <section id="hcr" class="a4-act a4-scene a4-hcr" data-a4 data-a4-scene data-sc-act="pin" data-sc-span="6" aria-labelledby="a4-hcr-t">
      <div data-sc-stage class="a4-st">
        <div class="a4-words" aria-hidden="true">
          {hcrPillars.map(([, , w], i) => <span class="a4-word" data-at={at(i, hcrPillars.length)} data-until={i < hcrPillars.length - 1 ? at(i + 1, hcrPillars.length) : undefined}>{w}</span>)}
        </div>
        <div class="a4-media">
          <!-- HCR VIDEO SLOT: replace with <video data-scrub data-src=... data-src-mobile=... muted playsinline> (see top of file) -->
          <div class="a4-media--placeholder"><span>Human centric robotics · video in arrivo</span></div>
        </div>
        <div class="a4-scene-head">
          <div class="chapter-label text-heading-2 a4-label">Human centric robotics</div>
          <p id="a4-hcr-t" class="a4-scene-vision">Human-centered robotics marks the transition from automation as a substitute to automation as a <em>partner</em>, placing the operator back at the very center of the industrial landscape.</p>
        </div>
        <div class="a4-pillars" aria-label="Pillars of the vision">
          <div class="text-heading-2 a4-pillars-k">Pillars of the vision</div>
          <div class="a4-pillars-stack">
            {hcrPillars.map(([t, d], i) => (
              <div class="a4-pillar" data-at={at(i, hcrPillars.length)} data-until={i < hcrPillars.length - 1 ? at(i + 1, hcrPillars.length) : undefined}>
                <h3>{t}</h3>
                <p>{d}</p>
              </div>
            ))}
          </div>
          <ol class="a4-ticks" aria-hidden="true">{hcrPillars.map((_, i) => <li data-at={at(i, hcrPillars.length)}></li>)}</ol>
        </div>
      </div>
    </section>

    <RelatedRail id="a4-hcr-rel" items={hcrActivities} />

    <!-- ═══ 4 · HUMAN IN THE LOOP · the peak: every simulator rises over its own word ═══ -->
    <section id="hitl" class="a4-act a4-scene a4-hitl" data-a4 data-a4-scene data-sc-act="pin" data-sc-span="6.4" aria-labelledby="a4-hitl-t">
      <div data-sc-stage class="a4-st">
        <div class="a4-words" aria-hidden="true">
          {devices.map((d, i) => <span class="a4-word" data-device={i}>{d.word}</span>)}
        </div>
        <div class="a4-media">
          <video data-scrub data-from="0.3" data-to="11.5" data-src={v4('hitl.mp4')} data-src-mobile={v4('hitl-m.mp4')} poster={v4('hitl-poster.jpg')} muted playsinline preload="none" aria-label="Animation: the lab's human-in-the-loop simulators assemble one after another: hazelnut pruning, cycling, skeleton, driving and balance platforms."></video>
        </div>
        <div class="a4-scene-head">
          <div class="chapter-label text-heading-2 a4-label">Human in the loop</div>
          <p id="a4-hitl-t" class="a4-scene-vision">Human-in-the-Loop (HITL) simulation is a «sandbox» where human intuition meets predictive technology, renders human-centric robotics safe, scalable, and flawless by design. <em>One architecture, several devices</em> for any activity where human performance is monitored, studied, trained and enhanced.</p>
        </div>
        <div class="a4-pillars" aria-label="Pillars of the vision">
          <div class="text-heading-2 a4-pillars-k">Pillars of the vision</div>
          <div class="a4-pillars-stack">
            {hitlPillars.map(([t, d], i) => (
              <div class="a4-pillar" data-at={at(i, hitlPillars.length)} data-until={i < hitlPillars.length - 1 ? at(i + 1, hitlPillars.length) : undefined}>
                <h3>{t}</h3>
                <p>{d}</p>
              </div>
            ))}
          </div>
          <ol class="a4-ticks" aria-hidden="true">{hitlPillars.map((_, i) => <li data-at={at(i, hitlPillars.length)}></li>)}</ol>
        </div>
      </div>
    </section>

    <RelatedRail id="a4-hitl-rel" items={hitlActivities} />

    <!-- ═══ 5 · LAB FACILITIES · four cards, icons that draw, real counts ═══ -->
    <section class="a4-lab" aria-labelledby="a4-lab-t">
      <div class="a4-rel-head">
        <h2 id="a4-lab-t" class="chapter-label text-heading-2 a4-label">Lab facilities &amp; infrastructure</h2>
        <p class="text-body a4-lab-intro">Our state-of-the-art lab facilities are equipped to support cutting-edge research and development in robotics and automation.</p>
      </div>
      <div class="a4-fac-grid" data-sc-in data-sc-stagger="110">
        {facilities.map((f) => (
          <article class="a4-fac">
            <span class="a4-ico" aria-hidden="true" set:html={f.icon} />
            <h3 class="a4-fac-title">{f.title}</h3>
            <ul class="a4-fac-list">{f.items.map((it) => <li class="text-list-meta">{it}</li>)}</ul>
          </article>
        ))}
      </div>
    </section>

    <!-- ═══ 6 · LONG-TERM VISION · the lab itself behind the last sentence ═══ -->
    <section class="a4-act a4-close" data-a4 data-sc-act="pin" data-sc-span="2.2" aria-labelledby="a4-close-t">
      <div data-sc-stage class="a4-st a4-close-st">
        <div class="a4-close-photo"><img src={withBase('/images/about/lab-hall.jpg')} alt="The RAMSLAB hall: a hexapod motion platform in front of a curved immersive screen, with industrial machines in the background." /></div>
        <div class="a4-close-in">
          <div class="text-heading-2 a4-close-k" id="a4-close-t">Long-term vision</div>
          <p class="a4-close-text">{longTerm.split(' ').map((w, i) => <span class="a4-q" data-q={i}>{w} </span>)}</p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  </div>

  <script is:inline src={withBase('/scrollcraft/scrollcraft.js')}></script>
  <script is:inline define:vars={{ devices }}>
    ScrollCraft.mount(document.body);

    (function () {
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var mobile = window.matchMedia('(max-width: 767px)').matches;
      var clamp = function (v) { return v < 0 ? 0 : v > 1 ? 1 : v; };
      var pOf = function (el) { return reduce ? 1 : parseFloat(el.style.getPropertyValue('--sc-p')) || 0; };
      var acts = [].slice.call(document.querySelectorAll('[data-a4]'));

      // Scrubbed clips inside a scene: the clip (optionally trimmed with
      // data-from / data-to, in seconds) plays across the scene's whole
      // progress and reaches its last kept frame as the scene starts to leave.
      var clips = [].slice.call(document.querySelectorAll('[data-a4-scene] video[data-scrub]')).map(function (v) {
        var c = { v: v, act: v.closest('[data-a4-scene]'), loaded: false, seeking: false };
        v.muted = true;
        v.addEventListener('seeked', function () { c.seeking = false; });
        v.addEventListener('loadeddata', function () { v.play().then(function () { v.pause(); }).catch(function () {}); }, { once: true });
        return c;
      });
      function scrub(c) {
        if (!c.loaded && c.act.getBoundingClientRect().top < innerHeight * 2.5) {
          c.loaded = true;
          var src = (mobile && c.v.dataset.srcMobile) || c.v.dataset.src;
          fetch(src).then(function (r) { return r.blob(); })
            .then(function (b) { c.v.src = URL.createObjectURL(b); })
            .catch(function () { c.v.src = src; });
        }
        if (!c.v.duration || c.seeking || c.v.seeking) return;
        var from = parseFloat(c.v.dataset.from) || 0;
        var to = Math.min(parseFloat(c.v.dataset.to) || c.v.duration, c.v.duration - 0.05);
        var target = from + clamp(pOf(c.act) / 0.97) * (to - from);
        var delta = target - c.v.currentTime;
        if (Math.abs(delta) > 0.015) { c.seeking = true; c.v.currentTime += reduce ? delta : delta * 0.2; }
      }

      var hitl = document.querySelector('.a4-hitl');
      var hv = hitl.querySelector('video');
      var words = [].slice.call(hitl.querySelectorAll('[data-device]'));

      var close = document.querySelector('.a4-close');
      var qWords = [].slice.call(close.querySelectorAll('[data-q]'));

      function frame() {
        acts.forEach(function (act) {
          var p = pOf(act);
          act.querySelectorAll('[data-at]').forEach(function (el) {
            var a = parseFloat(el.dataset.at);
            var until = el.dataset.until ? parseFloat(el.dataset.until) : 9;
            el.classList.toggle('on', reduce ? !el.dataset.until : p >= a && p < until);
          });
        });

        clips.forEach(scrub);

        // the giant word behind the HITL clip follows the clip's own clock
        var t = hv.currentTime || 0, cur = 0;
        devices.forEach(function (d, i) { if (t >= d.from) cur = i; });
        words.forEach(function (w, i) { w.classList.toggle('on', i === cur); w.classList.toggle('done', i < cur); });

        var cp = pOf(close);
        qWords.forEach(function (w, i) { w.classList.toggle('lit', reduce || cp >= 0.04 + (i / qWords.length) * 0.5); });

        if (!reduce) requestAnimationFrame(frame);
      }
      frame();
    })();
  </script>

  <style is:global>
    .a4, body:has(.a4) {
      --sc-canvas: #ffffff;
      --sc-surface: #f2f2f2;
      --sc-ink: #111111;
      --sc-ink-soft: #5f5f5f;
      --sc-accent: #b2284b;
      --sc-accent-ink: #ffffff;
      --sc-font-display: "Roboto", sans-serif;
      --sc-font-text: "Roboto", sans-serif;
      --sc-font-mono: "Roboto", sans-serif;
      --a4-red: #b2284b;
      --a4-tint: #f5e4e9;
      --a4-top: 72px;
    }
    body:has(.a4) { background: #fff; color: var(--text); font-size: 1rem; line-height: 1.45; letter-spacing: normal; }
    html:has(.a4) { background: #fff; scroll-behavior: auto; }
    .a4 main.a4-main { min-height: 0; overflow-x: visible; padding-bottom: 0; max-width: none; }
    .a4 [data-sc-progress] { background: var(--a4-red); }
    .a4-act { position: relative; background: #fff; }
    .a4-st { --p: var(--sc-p, 0); background: #fff; overflow: hidden; }
    .a4 em { font-style: normal; color: var(--a4-red); }

    /* the site's editorial type */
    .a4 .chapter-label { display: flex; gap: 12px; margin-bottom: 20px; color: var(--muted); }
    .a4-label { color: var(--a4-red) !important; }
    .a4-h2 { font-weight: 700; font-size: clamp(1.9rem, 3.6vw, 3.25rem); line-height: 1.08; letter-spacing: -0.0265em; margin: 0; max-width: 22ch; }
    .a4-pagehead { align-items: flex-end; gap: 32px; }
    .a4-motto { color: var(--muted); max-width: 34ch; text-align: right; padding-bottom: 14px; }

    /* ═══ 1 · HERO ═══ */
    .a4-hero-st {
      display: grid; align-content: center; justify-items: center; padding: var(--a4-top) var(--pad) 0;
      --draw: clamp(0, (var(--p) - 0.015) / 0.24, 1);
      --fill: clamp(0, (var(--p) - 0.2) / 0.08, 1);
      --say: clamp(0, (var(--p) - 0.24) / 0.14, 1);
      --zoom: clamp(0, (var(--p) - 0.58) / 0.36, 1);
    }
    .a4-hero-k { color: var(--muted); margin: 0 0 3vh; opacity: calc(1 - var(--zoom) * 3); }
    .a4-hero-grid {
      margin: 0; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; column-gap: clamp(1.5rem, 3vw, 3.5rem); width: 100%;
      font-weight: 700; font-size: clamp(1.9rem, 4vw, 4.2rem); line-height: 1.04; letter-spacing: -0.0265em;
    }
    .a4-hero-l, .a4-hero-r { opacity: calc(var(--say) * (1 - var(--zoom) * 3)); }
    .a4-hero-l { text-align: right; transform: translateX(calc((1 - var(--say)) * -8vw)); }
    .a4-hero-r { text-align: left; transform: translateX(calc((1 - var(--say)) * 8vw)); }
    .a4-mark {
      width: clamp(10rem, 34vh, 22rem); height: auto; overflow: visible;
      transform-origin: 15% 27%;
      transform: scale(calc(1 + var(--zoom) * var(--zoom) * var(--zoom) * 90));
    }
    .a4-mark-body { fill: #111; fill-opacity: var(--fill); stroke: #111; stroke-opacity: min(1, var(--draw) * 30); stroke-width: 0.35; stroke-dasharray: 1; stroke-dashoffset: calc(1 - var(--draw)); }
    .a4-mark-head { fill: #111; transform-box: fill-box; transform-origin: center; transform: translateY(calc((1 - var(--fill)) * -14px)) scale(var(--fill)); }

    /* ═══ 2 · WHAT WE DO ═══ */
    .a4-what-st {
      --sl: clamp(0, (var(--p) - 0.44) / 0.14, 1);

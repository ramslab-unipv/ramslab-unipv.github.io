---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/assets';
import { entrySlug } from '../lib/entries';
import site from '../content/settings/site.json';

const img = (name: string) => withBase(`/images/about/${name}`);

/* ── Activities with a dedicated page (same routing as /activities/) ── */
const routes: Record<string, string> = {
  'demetra-nodes': '/activities/demetra/',
  'dynamica': '/activities/dynamica/',
  'air-flow-dynamic': '/activities/air-flow-dynamic/',
  'robotic-liquid-handling': '/activities/robotic-liquid-handling/',
  'human-centric-skeleton-simulator': '/activities/human-centric-skeleton-simulator/',
  'ahbi': '/activities/ahbi/',
  'drivesim': '/activities/drivesim/',
  'balance-platform-simulator': '/activities/balance-platform-simulator/',
  '3d-human-poses-estimation': '/activities/3d-human-poses-estimation/',
};
const all = await getCollection('activities', ({ data }) => !data.draft);
const pick = (slugs: string[]) =>
  slugs
    .map((s) => all.find((a) => entrySlug(a.id) === s))
    .filter(Boolean)
    .map((a) => ({
      href: routes[entrySlug(a!.id)] ? withBase(routes[entrySlug(a!.id)]) : null,
      title: a!.data.title,
      excerpt: a!.data.excerpt,
      cover: a!.data.cover,
      fit: a!.data.coverFit === 'contain' ? 'fit-contain' : 'fit-cover',
      meta: [a!.data.year ? String(a!.data.year) : null, a!.data.status?.replace(/ongoing/i, 'ONGOING')].filter(Boolean),
    }));

const hitlActivities = pick(['drivesim', 'balance-platform-simulator', 'human-centric-skeleton-simulator', '3d-human-poses-estimation', 'ahbi', 'demetra-nodes']);
const agentActivities = pick(['dynamica', 'robotic-liquid-handling']);
const industryActivities = pick(['air-flow-dynamic']);

/* ── Story chapters (used by the sticky index) ── */
const chapters = [
  { id: 'prologue', label: 'Who we are' },
  { id: 'vision', label: 'The vision' },
  { id: 'principles', label: 'Seven principles' },
  { id: 'loop', label: 'Humans in the loop' },
  { id: 'automotive', label: 'A lesson from cars' },
  { id: 'agents', label: 'From intent to action' },
  { id: 'industry', label: 'Into industry' },
  { id: 'lab', label: 'The lab' },
  { id: 'epilogue', label: 'What comes next' },
];
const num = (i: number) => String(i).padStart(2, '0');

const manifesto =
  'Human-centred robotics marks the transition from automation as a substitute to automation as a partner, placing the operator back at the very centre of the industrial landscape.';

const principles = [
  ['Ultimate Human Tool', 'The robot as the ultimate extension of human capability.'],
  ['Democratizing Robotics', 'Making robotic technology accessible to everyone, not only to specialists.'],
  ['Unlocking Creativity', 'Giving room to creative thinking inside production processes.'],
  ['Reduce Repetitive Tasks', 'Freeing workers from monotonous, repetitive work.'],
  ['No-Code Approach', 'Intuitive interfaces that require no programming knowledge.'],
  ['Agentic Framework', 'Human–machine interaction driven by intelligent agentic systems.'],
  ['Physical AI', 'Intelligent systems embodied in, and acting on, the physical world.'],
];

const hitl = [
  ['Zero-risk validation', 'Safety and comfort are validated in a controlled, consequence-free environment.'],
  ['Mapping human behaviour', 'Real human motion and decision patterns are captured and modelled.'],
  ['Testing of devices', 'Devices are rigorously evaluated within a fully controlled environment.'],
  ['Cognitive load assessment', 'Mental effort is measured to keep human–robot interaction intuitive and ergonomic.'],
];

const automotive = [
  ['Driving simulators as enablers', 'Simulators provided the environment to develop and validate increasingly intelligent vehicle technologies.'],
  ['From simulation to autonomy', 'This is how modern driver-assistance and autonomous driving systems became possible.'],
  ['The same principle for robotics', 'A manufacturing simulator becomes the environment where intelligent robotic systems are developed, trained and validated.'],
  ["Shifting the operator's role", 'Increasing intelligence progressively moves the operator from controlling the system to defining the objective.'],
];

const projects = [
  ['Pharmaceutical Production Plant', 'Pharma'],
  ['Humanoid Robots for Livestock Management', 'Agriculture'],
  ['Agricultural Systems Safety — RoboVeg', 'Agriculture'],
  ['Laser Finishing for Luxury Composite Components', 'Composites'],
  ['Robotic Composite Manufacturing', 'Composites'],
];

const stats = [
  [17, '', 'NVIDIA RTX GPUs for training, simulation and vision'],
  [7, '', 'industrial and collaborative robots'],
  [8, ' m', 'curved immersive display on a hexapod motion platform'],
  [6, '-DoF', 'force platform for human-in-the-loop experiments'],
] as const;

const facilities = [
  ['Robotic systems', ['Mitsubishi RV-5-AS-D', 'Mitsubishi RV-8CRL-D-S15', 'Mitsubishi RV-2FRB-D-S25', 'Omron TM12, Omron TM5', 'Dobot CR10AS', 'Kawasaki MC004N']],
  ['Simulation & testing', ['Hexapod motion platform with 8 m curved immersive display', '6-DoF force platform', 'Real-time optical and markerless motion capture', 'Driving simulator, balance board', 'Pharmaceutical isolator', 'Infinadeck omnidirectional treadmill']],
  ['Computing', ['Workstations and computing servers', 'NAS for data storage and processing', 'GPU clusters: 8× RTX 3090, 6× RTX 4080, 3× RTX 4090', 'Edge: NVIDIA Jetson Orin & Nano, Raspberry Pi 5']],
  ['Manufacturing & prototyping', ['3D prototyping', 'CO₂ laser cutting', 'Optical table for precision measurement']],
] as const;
---

<BaseLayout title={`About — ${site.siteTitle}`} description="The RAMSLAB story: human-centric robotics and human-in-the-loop simulation at the University of Pavia.">
  <script is:inline>
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('about-anim');
  </script>
  <Header />
  <div class="about-progress" aria-hidden="true"><span></span></div>

  <main id="main-content" class="projects-page-main about">

    <!-- ─── Page header (same as /activities/) ─── -->
    <section class="projects-header-section">
      <div class="projects-header-container">
        <div class="projects-header-content about-header">
          <h1 class="projects-title-big about-title"><span>About</span></h1>
          <p class="text-link-header about-header-motto" style="color: var(--muted);">{site.siteMotto}</p>
        </div>
      </div>
    </section>

    <div class="about-story">

      <!-- ─── Sticky chapter index ─── -->
      <aside class="about-index" aria-label="Chapters">
        <nav>
          <div class="text-heading-2 about-index-title">The story</div>
          <ol>
            {chapters.map((c, i) => (
              <li><a href={`#${c.id}`} data-chapter-link={c.id}><span class="about-index-num">{num(i)}</span>{c.label}</a></li>
            ))}
          </ol>
          <div class="about-index-track"><span></span></div>
        </nav>
      </aside>

      <div class="about-chapters">

        <!-- 00 ─ PROLOGUE -->
        <section class="chapter" id="prologue" aria-labelledby="t-prologue">
          <div class="chapter-label text-heading-2" data-reveal><span>00</span>Who we are</div>
          <h2 class="chapter-title" id="t-prologue" data-reveal>A robotics lab that starts from people.</h2>
          <div class="chapter-cols">
            <p class="text-body" data-reveal>RAMSLAB — Research on Advanced Mechanical Systems — is a laboratory of the University of Pavia founded and led by Prof. Hermes Giberti. We bring innovation and creativity to industrial and research applications through robotics and dynamic simulators.</p>
            <p class="text-body" data-reveal>Our work moves between two worlds: industrial robots and cobots that take on real production tasks, and immersive simulators — for driving, sport, rehabilitation and agriculture — where people can be studied, trained and protected. What connects them is a single idea about the role of the human.</p>
          </div>
          <figure class="about-figure about-figure--wide" data-wipe>
            <img src={img('lab-hall.jpg')} alt="The RAMSLAB hall: a hexapod motion platform in front of a curved immersive screen, with industrial machines in the background." loading="lazy" />
          </figure>
        </section>

        <!-- 01 ─ VISION -->
        <section class="chapter" id="vision" aria-labelledby="t-vision">
          <div class="chapter-label text-heading-2" data-reveal><span>01</span>The vision</div>
          <h2 class="sr-only" id="t-vision">The vision</h2>
          <p class="about-manifesto">
            {manifesto.split(' ').map((w) => <span class="w">{w} </span>)}
          </p>
          <div class="chapter-cols about-ideas">
            <div class="about-idea" data-reveal>
              <div class="text-heading-2">Human Centric Robotics</div>
              <p class="text-body">Robotics as a system that enhances human capabilities — designed to combine quality, flexibility and worker safety in production processes that cannot be fully standardised.</p>
            </div>
            <div class="about-idea" data-reveal>
              <div class="text-heading-2">Human in the Loop</div>
              <p class="text-body">Operators become part of the production system's observation and decision-making cycle, turning human behaviour into actionable data to evaluate functionality, efficiency and safety.</p>
            </div>
          </div>
          <figure class="about-figure about-figure--plain" data-wipe>
            <img src={img('hcr-hitl.jpg')} alt="Illustration: an operator working next to a robot in a monitored production cell, and a person in VR on an omnidirectional treadmill tracked by cameras." loading="lazy" />
          </figure>
        </section>

        <!-- 02 ─ PRINCIPLES -->
        <section class="chapter" id="principles" aria-labelledby="t-principles">
          <div class="chapter-label text-heading-2" data-reveal><span>02</span>Seven principles</div>
          <h2 class="chapter-title" id="t-principles" data-reveal>From automation as a substitute to automation as a partner.</h2>
          <ol class="about-rows">
            {principles.map(([t, d], i) => (
              <li class="about-row">
                <span class="about-row-num">{num(i + 1)}</span>
                <span class="about-row-title">{t}</span>
                <span class="about-row-text">{d}</span>
              </li>
            ))}
          </ol>
        </section>

        <!-- 03 ─ HUMANS IN THE LOOP -->
        <section class="chapter" id="loop" aria-labelledby="t-loop">
          <div class="chapter-label text-heading-2" data-reveal><span>03</span>Humans in the loop</div>
          <h2 class="chapter-title" id="t-loop" data-reveal>A sandbox where human intuition meets predictive technology.</h2>
          <div class="about-loop">
            <div>
              <p class="text-body about-lead" data-reveal>Human-in-the-loop simulation makes human-centric robotics safe, scalable and flawless by design. For us it is not just a testing methodology: it is the catalyst for the next industrial revolution.</p>
              <dl class="about-grid4">
                {hitl.map(([t, d], i) => (
                  <div data-reveal>
                    <dt class="text-list-title"><span class="about-row-num">{num(i + 1)}</span>{t}</dt>
                    <dd class="text-list-meta">{d}</dd>
                  </div>
                ))}
              </dl>
            </div>
            <figure class="about-figure about-figure--plain about-loop-figure" data-wipe>
              <img src={img('hitl-treadmill.jpg')} alt="Illustration of a person in a VR headset walking on an omnidirectional treadmill surrounded by motion-capture cameras." loading="lazy" />
            </figure>
          </div>
          <div class="about-sub text-heading-2" data-reveal>Where it happens</div>
          <div class="activities-grid-container about-cards">
            {hitlActivities.map((a) => (
              <article class={`activity-card ${a.href ? 'activity-card-clickable' : 'activity-card-disabled'}`}>
                <a href={a.href ?? undefined} class="activity-card-image-link"><img src={withBase(a.cover)} alt="" class={a.fit} loading="lazy" /></a>
                <div class="activity-card-info">
                  <div class="activity-card-meta">{a.meta.map((m, i) => <>{i > 0 && <span>·</span>}<span>{m}</span></>)}</div>
                  <h3 class="activity-card-title">{a.href ? <a href={a.href}>{a.title}</a> : a.title}</h3>
                  {a.excerpt && <p class="activity-card-excerpt">{a.excerpt}</p>}
                </div>
              </article>
            ))}
          </div>
        </section>

        <!-- 04 ─ AUTOMOTIVE -->
        <section class="chapter" id="automotive" aria-labelledby="t-auto">
          <div class="chapter-label text-heading-2" data-reveal><span>04</span>A lesson from cars</div>
          <h2 class="chapter-title" id="t-auto" data-reveal>Simulators made cars intelligent. They will do the same for robots.</h2>
          <div class="about-auto">
            <div class="about-timeline">
              <span class="about-timeline-line" aria-hidden="true"><span></span></span>
              <ol class="about-timeline-list">
                {automotive.map(([t, d], i) => (
                  <li class="about-step">
                    <span class="about-step-dot" aria-hidden="true"></span>
                    <div class="text-list-title"><span class="about-row-num">{num(i + 1)}</span>{t}</div>
                    <p class="text-body">{d}</p>
                  </li>
                ))}
              </ol>
            </div>
            <figure class="about-figure about-figure--plain" data-wipe>
              <img src={img('automotive.jpg')} alt="Illustration: a driver relying on assistance systems, next to a driving simulator with immersive screens used to develop those systems." loading="lazy" />
            </figure>
          </div>
        </section>

        <!-- 05 ─ AGENTS -->
        <section class="chapter" id="agents" aria-labelledby="t-agents">
          <div class="chapter-label text-heading-2" data-reveal><span>05</span>From intent to action</div>
          <h2 class="chapter-title" id="t-agents" data-reveal>People define <em>what</em>. Intelligent agents work out <em>how</em>.</h2>

          <div class="about-flow" aria-label="Human intent, then intelligent agents, then robot execution">
            <div class="about-flow-node"><div class="text-heading-2">Human intent</div><p class="text-list-meta">Define what</p></div>
            <svg class="about-flow-link" viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true"><path d="M0 5H98M93 1l5 4-5 4" /></svg>
            <div class="about-flow-node"><div class="text-heading-2">Intelligent agents</div><p class="text-list-meta">Determine how</p></div>
            <svg class="about-flow-link" viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true"><path d="M0 5H98M93 1l5 4-5 4" /></svg>
            <div class="about-flow-node"><div class="text-heading-2">Robot execution</div><p class="text-list-meta">Achieve the task</p></div>
          </div>

          <div class="about-kitting">
            <figure class="about-figure" data-wipe>
              <img src={img('kitting-xr.jpg')} alt="Mixed-reality view of a collaborative robot for kitting. The user says 'Spawn robot' and the assistant replies with instructions." loading="lazy" />
              <figcaption class="text-emphasis">Robotic kitting: the first validation of the approach, with voice commands, mixed reality and a local multi-agent system.</figcaption>
            </figure>
            <ol class="about-kitting-steps">
              <li data-reveal><div class="text-list-title">Natural language interface</div><p class="text-body">The operator describes the kitting task in plain language — no programming required.</p></li>
              <li data-reveal><div class="text-list-title">The agent translates commands</div><p class="text-body">An AI agent interprets the objective and breaks it down into executable robotic sub-tasks.</p></li>
              <li data-reveal><div class="text-list-title">The robot executes</div><p class="text-body">The robot carries out the sequence autonomously, adapting to real-world conditions.</p></li>
            </ol>
          </div>

          <div class="about-sub text-heading-2" data-reveal>Where it happens</div>
          <div class="activities-grid-container about-cards">
            {agentActivities.map((a) => (
              <article class={`activity-card ${a.href ? 'activity-card-clickable' : 'activity-card-disabled'}`}>
                <a href={a.href ?? undefined} class="activity-card-image-link"><img src={withBase(a.cover)} alt="" class={a.fit} loading="lazy" /></a>
                <div class="activity-card-info">
                  <div class="activity-card-meta">{a.meta.map((m, i) => <>{i > 0 && <span>·</span>}<span>{m}</span></>)}</div>
                  <h3 class="activity-card-title">{a.href ? <a href={a.href}>{a.title}</a> : a.title}</h3>
                  {a.excerpt && <p class="activity-card-excerpt">{a.excerpt}</p>}
                </div>
              </article>
            ))}
          </div>
        </section>

        <!-- 06 ─ INDUSTRY -->
        <section class="chapter" id="industry" aria-labelledby="t-industry">
          <div class="chapter-label text-heading-2" data-reveal><span>06</span>Into industry</div>
          <h2 class="chapter-title" id="t-industry" data-reveal>Validated in the lab, scaled to high-value production.</h2>
          <div class="chapter-cols">
            <p class="text-body" data-reveal>Once a task can be described by its goal, every step of a manufacturing process becomes an independent task. An intelligent planner orchestrates those tasks into a complete, optimised workflow.</p>
            <p class="text-body" data-reveal>We apply this to the robotic production of composite materials — filament winding and automated fibre placement, followed by mechanical and laser finishing guided by vision-based inspection — and to sterile pharmaceutical processes.</p>
          </div>
          <div class="about-pair">
            <figure class="about-figure" data-wipe>
              <img src={img('composite-cell.jpg')} alt="Mitsubishi industrial robot working on a carbon-fibre part." loading="lazy" />
              <figcaption class="text-emphasis">Robotic composite manufacturing</figcaption>
            </figure>
            <figure class="about-figure" data-wipe>
              <img src={img('dual-robot-finishing.jpg')} alt="Two collaborative robots finishing a composite helmet shell." loading="lazy" />
              <figcaption class="text-emphasis">Dual-robot finishing</figcaption>
            </figure>
          </div>

          <div class="about-sub text-heading-2" data-reveal>Current projects &amp; applications</div>
          <ul class="about-rows about-rows--projects">
            {projects.map(([t, tag]) => (
              <li class="about-row">
                <span class="about-row-title">{t}</span>
                <span class="about-row-text">{tag}</span>
              </li>
            ))}
          </ul>

          <div class="activities-grid-container about-cards">
            {industryActivities.map((a) => (
              <article class={`activity-card ${a.href ? 'activity-card-clickable' : 'activity-card-disabled'}`}>
                <a href={a.href ?? undefined} class="activity-card-image-link"><img src={withBase(a.cover)} alt="" class={a.fit} loading="lazy" /></a>
                <div class="activity-card-info">
                  <div class="activity-card-meta">{a.meta.map((m, i) => <>{i > 0 && <span>·</span>}<span>{m}</span></>)}</div>
                  <h3 class="activity-card-title">{a.href ? <a href={a.href}>{a.title}</a> : a.title}</h3>
                  {a.excerpt && <p class="activity-card-excerpt">{a.excerpt}</p>}
                </div>
              </article>
            ))}
          </div>
        </section>

        <!-- 07 ─ LAB -->
        <section class="chapter" id="lab" aria-labelledby="t-lab">
          <div class="chapter-label text-heading-2" data-reveal><span>07</span>The lab</div>
          <h2 class="chapter-title" id="t-lab" data-reveal>A space built to put humans in the loop.</h2>
          <ul class="about-stats">
            {stats.map(([v, suf, label]) => (
              <li>
                <span class="about-stat-value"><span class="about-count" data-to={v}>{v}</span>{suf}</span>
                <span class="text-list-meta">{label}</span>
              </li>
            ))}
          </ul>
          <div class="about-photos">
            <figure class="about-figure" data-wipe><img src={img('lab-robots.jpg')} alt="Researcher at a workstation next to two industrial robot arms." loading="lazy" /></figure>
            <figure class="about-figure" data-wipe><img src={img('vr-treadmill.jpg')} alt="Person in VR on the Infinadeck omnidirectional treadmill." loading="lazy" /></figure>
            <figure class="about-figure" data-wipe><img src={img('balance-board.jpg')} alt="Person standing on the active balance board in front of a screen." loading="lazy" /></figure>
            <figure class="about-figure" data-wipe><img src={img('robot-dark.jpg')} alt="Robot arm lit in a dark test environment." loading="lazy" /></figure>
          </div>
          <div class="about-facilities">
            {facilities.map(([t, items]) => (
              <div data-reveal>
                <div class="text-heading-2">{t}</div>
                <ul>{items.map((it) => <li class="text-list-meta">{it}</li>)}</ul>
              </div>
            ))}
          </div>
        </section>

        <!-- 08 ─ EPILOGUE -->
        <section class="chapter chapter--last" id="epilogue" aria-labelledby="t-epilogue">
          <div class="chapter-label text-heading-2" data-reveal><span>08</span>What comes next</div>
          <h2 class="sr-only" id="t-epilogue">What comes next</h2>
          <blockquote class="about-quote">
            <p>Instead of programming robot motions, the operator will simply specify the product to manufacture — while the system determines how to accomplish the task.</p>
            <footer class="text-heading-2" data-reveal>RAMSLAB long-term vision</footer>
          </blockquote>
          <div class="about-links" data-reveal>
            <a href={withBase('/activities/')} class="text-heading-2">Explore the activities <span aria-hidden="true">➞</span></a>
            <a href={withBase('/people/')} class="text-heading-2">Meet the people <span aria-hidden="true">➞</span></a>
            <a href={withBase('/publications/')} class="text-heading-2">Read the publications <span aria-hidden="true">➞</span></a>
            <a href={`mailto:${site.contactEmail}`} class="text-heading-2">{site.contactEmail}</a>
          </div>
        </section>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  /* ── Chapter index + reading progress (works with or without motion) ── */
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-chapter-link]'));
  const setActive = (id: string) => links.forEach((l) => l.classList.toggle('is-active', l.dataset.chapterLink === id));
  document.querySelectorAll<HTMLElement>('.chapter').forEach((ch) => {
    ScrollTrigger.create({
      trigger: ch, start: 'top 45%', end: 'bottom 45%',
      onToggle: (self) => { if (self.isActive) setActive(ch.id); },
    });
  });
  ScrollTrigger.create({
    trigger: '.about-chapters', start: 'top 45%', end: 'bottom bottom',
    onUpdate: (self) => {
      document.querySelector<HTMLElement>('.about-index-track span')?.style.setProperty('transform', `scaleY(${self.progress})`);
      document.querySelector<HTMLElement>('.about-progress span')?.style.setProperty('transform', `scaleX(${self.progress})`);
    },
  });

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduce) {
    /* Title */
    gsap.from('.about-title span', { yPercent: 100, duration: 1, ease: 'power4.out' });
    gsap.from('.about-header-motto', { opacity: 0, y: 12, duration: 0.8, delay: 0.3, ease: 'power3.out' });

    /* Generic reveal */
    gsap.utils.toArray<HTMLElement>('[data-reveal]').forEach((el) => {
      gsap.to(el, { opacity: 1, y: 0, duration: 0.8, ease: 'power3.out', scrollTrigger: { trigger: el, start: 'top 88%' } });
    });

    /* Images are uncovered from the bottom */
    gsap.utils.toArray<HTMLElement>('[data-wipe]').forEach((el) => {
      const im = el.querySelector('img');
      const tl = gsap.timeline({ scrollTrigger: { trigger: el, start: 'top 85%' } });
      tl.fromTo(el, { clipPath: 'inset(100% 0 0 0)' }, { clipPath: 'inset(0% 0 0 0)', duration: 1.1, ease: 'power3.inOut' });
      if (im && !el.classList.contains('about-figure--wide')) tl.fromTo(im, { scale: 1.12 }, { scale: 1, duration: 1.5, ease: 'power3.out' }, 0);
    });

    /* Wide prologue image: slow parallax */
    gsap.fromTo('.about-figure--wide img', { yPercent: -5 }, {
      yPercent: 5, ease: 'none',
      scrollTrigger: { trigger: '.about-figure--wide', start: 'top bottom', end: 'bottom top', scrub: true },
    });

    /* Manifesto: words go from grey to black as you read */
    gsap.to('.about-manifesto .w', {
      color: '#111111', stagger: 0.08, ease: 'none',
      scrollTrigger: { trigger: '.about-manifesto', start: 'top 75%', end: 'bottom 40%', scrub: 0.5 },
    });

    /* Numbered rows */
    gsap.utils.toArray<HTMLElement>('.about-rows').forEach((list) => {
      gsap.from(list.querySelectorAll('.about-row'), {
        opacity: 0, y: 24, duration: 0.6, stagger: 0.08, ease: 'power3.out',
        scrollTrigger: { trigger: list, start: 'top 80%' },
      });
    });

    /* Timeline */
    gsap.fromTo('.about-timeline-line span', { scaleY: 0 }, {
      scaleY: 1, ease: 'none',
      scrollTrigger: { trigger: '.about-timeline', start: 'top 70%', end: 'bottom 55%', scrub: true },
    });
    gsap.utils.toArray<HTMLElement>('.about-step').forEach((step) => {
      gsap.from(step, { opacity: 0, x: 24, duration: 0.7, ease: 'power3.out', scrollTrigger: { trigger: step, start: 'top 80%' } });
      ScrollTrigger.create({
        trigger: step, start: 'top 62%',
        onEnter: () => step.classList.add('is-active'),
        onLeaveBack: () => step.classList.remove('is-active'),
      });
    });

    /* Flow: nodes and arrows appear in sequence */
    const flow = gsap.timeline({ scrollTrigger: { trigger: '.about-flow', start: 'top 80%' } });
    const nodes = gsap.utils.toArray<HTMLElement>('.about-flow-node');
    const arrows = gsap.utils.toArray<SVGPathElement>('.about-flow-link path');
    arrows.forEach((p) => { const l = p.getTotalLength(); gsap.set(p, { strokeDasharray: l, strokeDashoffset: l }); });
    nodes.forEach((n, i) => {
      flow.from(n, { opacity: 0, y: 16, duration: 0.5, ease: 'power3.out' });
      if (arrows[i]) flow.to(arrows[i], { strokeDashoffset: 0, duration: 0.5, ease: 'power2.inOut' });
    });

    /* Activity cards */
    gsap.utils.toArray<HTMLElement>('.about-cards').forEach((grid) => {
      gsap.from(grid.querySelectorAll('.activity-card'), {
        opacity: 0, y: 32, duration: 0.7, stagger: 0.1, ease: 'power3.out',
        scrollTrigger: { trigger: grid, start: 'top 85%' },
      });
    });

    /* Counters */
    gsap.utils.toArray<HTMLElement>('.about-count').forEach((el) => {
      const to = Number(el.dataset.to || 0);
      const o = { v: 0 };
      el.textContent = '0';
      gsap.to(o, {
        v: to, duration: 1.4, ease: 'power2.out',
        onUpdate: () => { el.textContent = String(Math.round(o.v)); },
        scrollTrigger: { trigger: el, start: 'top 88%' },
      });
    });

    /* Epilogue quote: words darken as you read */
    const q = document.querySelector('.about-quote p');
    if (q && q.textContent) {
      q.innerHTML = q.textContent.split(' ').map((w) => `<span class="w">${w} </span>`).join('');
      gsap.to('.about-quote .w', {
        color: '#111111', stagger: 0.08, ease: 'none',
        scrollTrigger: { trigger: '.about-quote', start: 'top 80%', end: 'bottom 50%', scrub: 0.5 },
      });
    }

    window.addEventListener('load', () => ScrollTrigger.refresh());
  }
</script>


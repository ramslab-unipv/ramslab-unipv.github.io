---
import ProjectStoryLayout from '../../components/ProjectStoryLayout.astro';
import { getProjectPublications } from '../../lib/publications';

const publications = await getProjectPublications('3d-human-poses-estimation');
---

<ProjectStoryLayout
  title={"Real-time 3D Human Pose Estimation"}
  subtitle={"Markerless motion measurement from multiple camera views"}
  accentColor="#3ba776"
  activity="3d-human-poses-estimation"
  cover={{
    "video": "/videos/scroll/poses-world.mp4",
    "poster": "/videos/scroll/poses-world-poster.jpg",
    "alt": "The reconstructed 3D skeleton of a subject moving on the platform."
  }}
  vision={"The system reconstructs three-dimensional body keypoints from camera images for use in human-in-the-loop simulators."}
  chapters={[
    {
      "kind": "media",
      "label": "Multi-camera acquisition",
      "text": "Calibrated cameras record the person from different viewpoints. Their relative positions and orientations define a common reference frame for reconstruction. Synchronised acquisition allows detections of the same body keypoint to be compared across views.",
      "media": [
        {
          "video": "/videos/projects/CameraAcquisition.mp4",
          "alt": "Four synchronized cameras record the subject from different viewpoints.",
          "ratio": 2.3869
        }
      ]
    },
    {
      "kind": "media",
      "label": "2D keypoint detection",
      "text": "A pretrained YOLO pose-estimation model identifies body keypoints in each camera image. Temporal filtering reduces fluctuations in the detections before the observations from different views are combined.",
      "media": [
        {
          "video": "/videos/projects/2DPoseDetection.mp4",
          "alt": "2D body keypoints detected by YOLO-pose in each camera view.",
          "ratio": 2.3869
        }
      ]
    },
    {
      "kind": "media",
      "label": "Triangulation",
      "text": "Weighted Direct Linear Triangulation estimates the three-dimensional position of each keypoint from its two-dimensional observations. The weighting accounts for the consistency of detections across frames, reducing the influence of less reliable observations.",
      "media": [
        {
          "video": "/videos/projects/Triangulation.mp4",
          "alt": "The triangulated 3D keypoints drive a body model standing on the platform.",
          "ratio": 2.3869
        }
      ]
    },
    {
      "kind": "media",
      "label": "Integration with motion platforms",
      "text": "The reconstructed body pose provides an input to human-in-the-loop simulators. The published work includes integration with a three-degree-of-freedom platform for exergames, where measured body movement contributes to the platform motion reference.",
      "media": [
        {
          "video": "/videos/scroll/poses-cases.mp4",
          "poster": "/videos/scroll/poses-cases-poster.jpg",
          "alt": "From the four camera views to the 3D skeleton, in real time.",
          "ratio": 1.7778
        }
      ]
    }
  ]}
  description={"RAMSLAB develops a camera-based system for real-time 3D human pose estimation without markers attached to the body. The processing pipeline combines pretrained 2D pose detection, temporal filtering and weighted triangulation. The system has been evaluated using the Human3.6M dataset and integrated with a motion platform for exergames. Its output supports the study of interactions between a person and a simulated dynamic system."}
  publications={publications}
  prevActivity={{
    "label": "Human-in-the-Loop Skeleton Simulator",
    "href": "/activities/human-centric-skeleton-simulator/"
  }}
  nextActivity={{
    "label": "Balance Platform Simulator",
    "href": "/activities/balance-platform-simulator/"
  }}
/>

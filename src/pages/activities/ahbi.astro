---
import ProjectStoryLayout from '../../components/ProjectStoryLayout.astro';
import { getProjectPublications } from '../../lib/publications';

const publications = await getProjectPublications('ahbi');
---

<ProjectStoryLayout
  title="Advancing Human-Centric Bicycle Innovation (AHBI)"
  accentColor="#a78bfa"
  activity="ahbi"
  cover={{
    image: '/images/projects/bike_HPE.jpg',
    alt: 'Camera views of a cyclist with detected body keypoints.',
  }}
  vision="AHBI investigates camera-based methods for measuring rider posture during indoor cycling."
  chapters={[
    {
      kind: 'media',
      label: 'Markerless pose reconstruction',
      text: 'The measurement system detects body keypoints in synchronised camera images. Weighted triangulation combines observations from different views to reconstruct the three-dimensional pose of the cyclist.',
      media: [{ image: '/images/projects/bike_HPE.jpg', alt: 'Four camera views with detected body keypoints overlaid on a cyclist.', ratio: 1.4075 }],
    },
    {
      kind: 'media',
      label: 'Reference measurements',
      text: 'Controlled indoor cycling trials compare the markerless measurements with an OptiTrack motion-capture reference. Synchronised acquisition allows reconstructed joint positions and joint angles to be assessed during the same movements.',
      media: [{ image: '/images/projects/setup1.jpg', alt: 'A bicycle mounted on an indoor trainer in the laboratory.', ratio: 1.332 }],
    },
    {
      kind: 'media',
      label: 'Metrological evaluation',
      text: 'The conference study evaluates joint-position errors, joint-angle errors, correlation with reference measurements and processing time. This characterises the performance of the measurement method under the tested cycling conditions.',
    },
  ]}
  description="The published cycling study evaluates a multi-camera markerless system for measuring rider posture. Two-dimensional body detections are reconstructed in 3D and compared with optoelectronic reference measurements during indoor cycling. The work examines measurement errors and processing time for this application."
  publications={publications}
  funding={"This activity is supported within MOST — Sustainable Mobility National Research Center, Spoke 5 \"Light Vehicle and Active Mobility\" (project CN00000023), funded by the European Union — NextGenerationEU under the Italian National Recovery and Resilience Plan (PNRR), Mission 4, Component 2, Investment 1.4."}
  prevActivity={{ label: 'Driving Simulator', href: '/activities/drivesim/' }}
  nextActivity={{ label: 'DEMETRA', href: '/activities/demetra/' }}
/>

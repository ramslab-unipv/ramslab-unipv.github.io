---
import ProjectScrollLayout from '../../components/ProjectScrollLayout.astro';
import { getProjectPublications } from '../../lib/publications';

const project = {
  title: "ADVANCING HUMAN-CENTRIC BICYCLE INNOVATION (AHBI)",
  subtitle: "A human-centred framework integrating rider motion, bicycle dynamics and intelligent models for next-generation cycling simulation, research and design.",
  description: "The Advancing Human-Centric Bicycle Innovation (AHBI) project develops a human-centred framework for understanding and reproducing rider–bicycle interaction. The project addresses the challenge of simulating cycling as a dynamic task in which the rider must simultaneously maintain balance and control direction. AHBI combines multibody modelling, experimental data, advanced sensing, markerless human motion capture and artificial intelligence. A biomechanical rider model was integrated into bicycle dynamics to improve the reproduction of balance, while experimental cycling data were used to develop data-driven models capable of predicting bicycle roll and yaw in real time. A hybrid physics–AI approach was also investigated to capture effects that are difficult to represent analytically while preserving adaptability to different bicycle geometries and rider properties. Together with the instrumented experimental setup, the framework provides a foundation for future human-in-the-loop bicycle simulators capable of reproducing balance, steering resistance and pedalling resistance for research, training and bicycle design.",
  funding: "MOST – National Center for Sustainable Mobility, Spoke No. 5.",
};
const publications = await getProjectPublications('ahbi');
---

<ProjectScrollLayout
  title={project.title}
  subtitle={project.subtitle}
  accentColor="#a78bfa"
  world={{ video: '/videos/scroll/ahbi-world.mp4', poster: '/videos/scroll/ahbi-world-poster.jpg' }}
  sections={[
    {
      label: "MULTIBODY MODELLING OF THE RIDER–BICYCLE SYSTEM",
      text: "Cycling requires the rider to maintain balance while controlling direction in an inherently unstable system. Since the rider accounts for more than 80% of the combined rider–bicycle mass but is often simplified in existing models, AHBI extends the nonlinear Carvallo–Whipple model with a biomechanical multibody rider representation based on the Yeadon formulation.",
      video: '/videos/projects/Animation_MB_rider.mp4'
    },
    {
      label: "BALANCE AS A VALIDATION CRITERION",
      text: "To assess how accurately the models reproduce real cycling balance, AHBI introduced a metric based on the corrective torque applied within the model about the bicycle’s roll axis to align its response with experimental motion. Across the analysed treadmill-cycling tests, the multibody rider model reduced the RMS corrective torque by approximately 5–65% compared with the fixed-rider model, indicating a more realistic representation of balance.",
      image: '/images/projects/T_roll.png'
    },
    {
      label: "DATA-DRIVEN MODELLING OF BICYCLE DYNAMICS",
      text: "To assess the ability of data-driven methods to reproduce cycling dynamics, an optimised LSTM model was trained on an openly available treadmill-cycling dataset. Bicycle speed, steering and crank motion, together with rider kinematics, were used to predict bicycle roll and yaw. On unseen tests, the model achieved normalised RMS errors of 0.058–0.106 and Pearson correlation coefficients of 0.78–0.89. With an inference latency of approximately 1 ms, it is suitable for future real-time human-in-the-loop simulation.",
      video: '/videos/projects/comp_ref_AI.mp4'
    },
    {
      label: "HYBRID INTELLIGENCE FOR REALISTIC CYCLING SIMULATION",
      text: "AHBI combines physics-based modelling with data-driven corrections. The physical model adapts to different bicycle geometries and rider inertial properties, while the data-driven component captures effects that are difficult to represent analytically. This hybrid approach preserves physical interpretability and adaptability while reducing the amount of training data needed to cover different rider and bicycle configurations.",
      image: '/images/projects/setup1.jpg'
    },
    {
      label: "EXPERIMENTAL SETUP — TOWARDS FULL RIDER–BICYCLE INTERACTION",
      text: "Within AHBI, an experimental setup was designed to enable future extensions of the framework. It combines markerless human motion capture with bicycle-mounted load cells, IMUs, smart pedals and motion-tracking systems to measure rider kinematics and rider–bicycle interaction forces. The AHBI framework improves the reproduction of balance dynamics, while its integration with the experimental setup lays the foundation for reproducing realistic steering and pedalling resistance. Together, they enable a more complete rider–bicycle interaction in future human-in-the-loop simulators.",
      image: '/images/projects/bike_HPE.jpg'
    }
  ]}
  description={project.description}
  publications={publications}
  funding={project.funding}
  prevActivity={{ label: "DriveSim", href: '/activities/drivesim/' }}
  nextActivity={{ label: "Demetra", href: '/activities/demetra/' }}
/>

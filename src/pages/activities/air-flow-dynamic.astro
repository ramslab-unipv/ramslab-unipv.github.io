---
import ProjectStoryLayout from '../../components/ProjectStoryLayout.astro';
import { getProjectPublications } from '../../lib/publications';

const publications = await getProjectPublications('air-flow-dynamic');
---

<ProjectStoryLayout
  title={"Airflow Dynamics in Robotic Pharmaceutical Isolators"}
  accentColor="#ccff00"
  activity="air-flow-dynamic"
  cover={{
    "video": "/videos/scroll/airflow-world.mp4",
    "poster": "/videos/scroll/airflow-world-poster.jpg",
    "alt": "A robotic tool moving through the smoke lines that reveal the isolator airflow."
  }}
  vision={"The research measures airflow inside pharmaceutical isolators to examine its interaction with moving robotic equipment."}
  chapters={[
    {
      "kind": "media",
      "label": "Airflow in the isolator",
      "text": "Filtered airflow is part of contamination control in pharmaceutical isolators. This activity examines the flow field inside the working volume and the disturbances introduced by robotic equipment.",
      "media": [
        {
          "video": "/videos/projects/Robotic_airflow_2.mp4",
          "alt": "Smoke lines reveal the unidirectional airflow around the robot inside the isolator.",
          "ratio": 1.7778
        }
      ]
    },
    {
      "kind": "media",
      "label": "Robot–airflow interaction",
      "text": "A moving robot can alter the surrounding airflow and produce local wakes or recirculation. Flow visualisation is used to examine these effects around the end-effector and within the process area.",
      "media": [
        {
          "image": "/images/projects/robot_airflow_interaction.png",
          "alt": "Smoke visualization of the airflow disturbed by a robotic end-effector.",
          "ratio": 1.5521,
          "chart": true,
          "beside": true
        }
      ]
    },
    {
      "kind": "media",
      "label": "Vision-based flow measurement",
      "text": "Tracer patterns make the air motion visible to cameras. Image-processing methods estimate the velocity field from these observations. The published study compares measurement algorithms and examines how tracer generation affects the quality of the estimated field.",
      "media": [
        {
          "image": "/images/projects/structured_smoke_visualization.png",
          "alt": "Structured smoke lines make the airflow visible, comparing two flow conditions (a) and (b).",
          "ratio": 1.5712,
          "chart": true,
          "beside": true
        }
      ]
    },
    {
      "kind": "media",
      "label": "Comparing robotic movements",
      "text": "Measured velocity fields provide a basis for comparing the disturbances associated with different robot movements. The comparison shown here considers vertical and horizontal motion of the arm.",
      "media": [
        {
          "image": "/images/projects/robot_motion_field_comparison.png",
          "alt": "Airflow motion fields for a vertical (left) and a horizontal (right) displacement of the robotic arm.",
          "ratio": 2.7273,
          "chart": true
        }
      ]
    },
    {
      "kind": "media",
      "label": "Research objectives",
      "text": "The longer-term objective is to use airflow measurements and models when selecting robot trajectories. This work investigates how the effects of motion direction, speed and acceleration could be included in trajectory assessment.",
      "media": [
        {
          "video": "/videos/projects/hero_robotic_airflow.mp4",
          "alt": "A robotic end-effector moving through the smoke lines and leaving a wake in the airflow.",
          "ratio": 1.5588
        }
      ]
    }
  ]}
  description={"This activity develops vision-based methods for measuring airflow inside robotic pharmaceutical isolators. Tracer visualisation and image analysis are used to estimate velocity fields and examine disturbances caused by moving equipment. The measurements support comparison of robot movements and research into the use of airflow information during trajectory assessment."}
  publications={publications}
  funding={"Funded by MED4REPAIR — Smart advanced medical devices for tissue repair, under Regione Lombardia's 'Collabora e Innova' call, PR FESR 2021–2027 (project ID 6064179; R1.2024.0005575 of 27 November 2024)."}
  prevActivity={{
    "label": "DYNAMICA",
    "href": "/activities/dynamica/"
  }}
  nextActivity={{
    "label": "Robotic Liquid Handling",
    "href": "/activities/robotic-liquid-handling/"
  }}
/>

---
import ProjectStoryLayout from '../../components/ProjectStoryLayout.astro';
import { getProjectPublications } from '../../lib/publications';

const publications = await getProjectPublications('balance-platform-simulator');
---

<ProjectStoryLayout
  title={"Balance Platform Simulator"}
  accentColor="#7dd3fc"
  activity="balance-platform-simulator"
  cover={{
    "image": "/images/projects/avatar_skii.png",
    "alt": "An avatar moves between gates on a virtual ski slope."
  }}
  vision={"The platform couples measured body movement with a simulated task to study balance in a laboratory setting."}
  chapters={[
    {
      "kind": "media",
      "label": "Platform motion",
      "text": "The platform provides roll, pitch and vertical translation. These degrees of freedom allow motion to be incorporated into balance exercises and interactive simulations.",
      "media": [
        {
          "image": "/images/projects/cad_sistema_schermo.png",
          "alt": "CAD model of the 3-DOF balance platform with its frame and screen.",
          "ratio": 1.7865
        }
      ]
    },
    {
      "kind": "media",
      "label": "Markerless body tracking",
      "text": "A four-camera system detects body keypoints and reconstructs the user's pose without wearable markers. The measurements provide an input to the model that determines the platform response.",
      "media": [
        {
          "image": "/images/projects/4cameras.png",
          "alt": "Four camera views of a participant standing on the platform.",
          "ratio": 2.0692,
          "chart": true
        }
      ]
    },
    {
      "kind": "media",
      "label": "Human-in-the-loop control",
      "text": "The interaction model uses body movement and platform state to generate motion references. Changing the model parameters changes how the platform responds to the user, allowing different exercise conditions to be investigated."
    },
    {
      "kind": "media",
      "label": "Exergame environment",
      "text": "The virtual task links body movement to an on-screen activity. In the ski exergame shown here, the user controls an avatar moving through a course. This provides a task context for studying the interaction between body motion and platform response.",
      "media": [
        {
          "image": "/images/projects/avatar_skii.png",
          "alt": "An avatar moves between gates on a virtual ski slope.",
          "ratio": 1.7855
        }
      ]
    },
    {
      "kind": "media",
      "label": "Research applications",
      "text": "The platform is intended for research on balance exercises in sport and rehabilitation. Published work describes the device, its control architecture and preliminary tests of the interaction between the user and the moving platform."
    }
  ]}
  description={"The Balance Platform Simulator is a three-degree-of-freedom motion platform for balance exercises and exergames. Markerless body measurements are used within a human-in-the-loop model to determine the platform response. The virtual environment presents a task while the participant interacts with the moving platform. The research examines the device design, motion control and measurement methods used to analyse this interaction."}
  publications={publications}
  funding={"This activity is supported by the Italian Ministry of University and Research (MUR) through the complementary actions to the National Recovery and Resilience Plan (NRRP), \"Fit4MedRob — Fit for Medical Robotics\" (grant PNC0000007)."}
  prevActivity={{
    "label": "Real-time 3D Human Pose Estimation",
    "href": "/activities/3d-human-poses-estimation/"
  }}
  nextActivity={{
    "label": "Driving Simulator",
    "href": "/activities/drivesim/"
  }}
/>

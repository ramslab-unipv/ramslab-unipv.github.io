---
import ProjectScrollLayout from '../../components/ProjectScrollLayout.astro';
import { getProjectPublications } from '../../lib/publications';

const project = {
  title: "DEMETRA",
  subtitle: "Pruning Virtual Training Simulator",
  vision: "Redefining agricultural precision through immersive virtual environments and robotic simulation.",
  description: "DEMETRA is an innovative research platform dedicated to the digitization of pruning techniques and the advancement of agricultural training. At its core, the project leverages a human-in-the-loop approach, placing the operator inside a highly immersive virtual environment. By seamlessly integrating advanced technologies, such as omnidirectional locomotion systems and authentic haptic interfaces, DEMETRA allows users to move freely and physically interact with digital plants exactly as they would in a real orchard. Beyond offering an unprecedented, safe, and optimized environment for upskilling agricultural workers, the platform serves a dual purpose. By combining high-fidelity physics simulations with precise digital twins, DEMETRA provides a robust, risk-free testing ground for validating and refining automated robotic pruning algorithms, shaping the future of smart agriculture.",
  funding: "Produced within the NODES project, financed by the MUR on M4C2 funds - Investment 1.5 'Innovation Ecosystems', within the PNRR financed by the European Union - NextGenerationEU (Grant agreement Cod. n.ECS00000036)."
};
const publications = await getProjectPublications('demetra');
---

<ProjectScrollLayout
  title={project.title}
  subtitle={project.subtitle}
  vision={project.vision}
  accentColor="#22c55e"
  world={{ video: '/videos/scroll/demetra-world.mp4', poster: '/videos/scroll/demetra-world-poster.jpg' }}
  sections={[
    {
      label: "Unlimited Locomotion",
      text: "Walk naturally through the virtual rows as if you were in the field. Explore the entire environment and select any tree with total freedom of movement.",
      video: '/videos/scroll/demetra-walker.mp4', poster: '/videos/scroll/demetra-walker-poster.jpg',
      videoLabel: "A person in a VR headset walking on the omnidirectional treadmill."
    },
    {
      label: "Digital Twin",
      text: "From high-resolution photogrammetry to high-fidelity virtual models. Real trees are reconstructed with absolute precision, allowing for realistic pruning simulations.",
      model: '/models/tree_old.glb', mediaSide: 'right'
    },
    {
      label: "Real-Tool Integration",
      text: "Erase the boundary between simulation and practice by using real pruning tools. Experience one-to-one haptic feedback in a real-time, accelerating skill acquisition through a natural and familiar tactile experience.",
      model: '/models/shear.glb', modelOptions: { build: false, anim: 'shears', size: 0.7 }, mediaSide: 'left'
    }
  ]}
  description={project.description}
  publications={publications}
  funding={project.funding}
  prevActivity={{ label: "AHBI", href: '/activities/ahbi/' }}
  nextActivity={{ label: "Dynamica", href: '/activities/dynamica/' }}
/>

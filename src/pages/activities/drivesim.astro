---
import ProjectStoryLayout from '../../components/ProjectStoryLayout.astro';
import { getProjectPublications } from '../../lib/publications';

const publications = await getProjectPublications('drivesim');
---

<ProjectStoryLayout
  title={"Driving Simulator"}
  subtitle={"Driving Simulator for Rehabilitation"}
  accentColor="#dc2626"
  activity="drivesim"
  cover={{
    "video": "/videos/scroll/drivesim-world.mp4",
    "poster": "/videos/scroll/drivesim-world-poster.jpg",
    "alt": "The driver’s view in the simulator: urban streets and exergame instructions."
  }}
  vision={"Bringing patients back behind the wheel through immersive, safe and multi-sensory driving rehabilitation."}
  chapters={[
    {
      "kind": "media",
      "label": "A MULTI-MODE EXPERIENCE",
      "text": "Whether you wish to drive freely around the streets, engage in mini exergames, or circulate within realistic traffic, the driving experience can be tailored to meet your specific needs and rehabilitation objectives.",
      "media": [
        {
          "image": "/images/projects/DriveSim_principale_blocco1.png",
          "alt": "A car driving through the simulator’s virtual city.",
          "ratio": 1.7662
        }
      ]
    },
    {
      "kind": "model",
      "label": "ADAPTIVE MULTI_FEEDBACK SYSTEM",
      "text": "To accommodate every specific need of both you and your patient, the system features a fully adjustable multi-feedback system. The 3 DOF platform, steering wheel, and pedals replicate all the sensations experienced during actual driving, while the virtual environment is completely visualized on the screen.",
      "model": "/models/DriveSim_seat_blocco2.glb",
      "side": "right"
    },
    {
      "kind": "model",
      "label": "TRACK YOUR PERFORMANCE",
      "text": "In any selected mode and scenario, the system enables the measurement of all metrics. Through high-frequency sampling of steering and pedal inputs, it records your performance during exergames as well as your driving behavior in realistic traffic.",
      "model": "/models/DriveSim_fiat_blocco3.glb",
      "side": "left",
      "modelOptions": {
        "build": false,
        "anim": "drive",
        "view": "top",
        "size": 1.2
      }
    }
  ]}
  description={"DriveSim represents a significant asset to rehabilitation therapy pathways for patients suffering from psychophysical pathologies. The objective is to present an immersive and effective experience, enabling patients to rebuild confidence in their coordination and reflexes within a familiar daily-life context. The immersive environment and multi-sensory (haptic and visual) feedback provide an enhanced sense of presence, faithfully reproducing urban driving scenarios. The three available modes allow for a differentiated experience across sessions: Free Driving, to navigate without obstacles and gain familiarity with the vehicle; Test Mode, which introduces four distinct mini-games (exergames) designed to evaluate user performance; and Traffic Mode, to re-accustom the patient to actual road driving with active traffic and road signs. Every component of the system and its operational modes can be calibrated to accommodate the precise requirements of both the therapist and the user. This operates within a totally secure, controlled environment that guarantees trial replicability for tracking performance and learning progress, which are available via a detailed data collection system."}
  publications={publications}
  funding={"Supported by Fit4MedRob framework"}
  prevActivity={{
    "label": "Balance Platform Simulator",
    "href": "/activities/balance-platform-simulator/"
  }}
  nextActivity={{
    "label": "AHBI",
    "href": "/activities/ahbi/"
  }}
/>

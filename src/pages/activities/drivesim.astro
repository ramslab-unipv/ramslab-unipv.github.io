---
import ProjectStoryLayout from '../../components/ProjectStoryLayout.astro';
import { getProjectPublications } from '../../lib/publications';

const publications = await getProjectPublications('drivesim');
---

<ProjectStoryLayout
  title={"Driving Simulator"}
  subtitle={"A dynamic platform for rehabilitation-oriented exergames and driving research"}
  accentColor="#dc2626"
  activity="drivesim"
  cover={{
    "video": "/videos/scroll/drivesim-world.mp4",
    "poster": "/videos/scroll/drivesim-world-poster.jpg",
    "alt": "The driver’s view in the simulator: urban streets and exergame instructions."
  }}
  vision={"DriveSim combines vehicle simulation, physical feedback and configurable tasks to study driving-related motor and cognitive performance."}
  chapters={[
    {
      "kind": "media",
      "label": "Driving modes and exergames",
      "text": "Free Driving supports familiarisation with the simulator. Test Mode provides four configurable exergames: Slalom, Speed Control, Linekeeping and Reaction Test. Traffic Mode introduces other vehicles and road rules within an urban scenario.",
      "media": [
        {
          "image": "/images/projects/DriveSim_principale_blocco1.png",
          "alt": "A car driving through the simulator’s virtual city.",
          "ratio": 1.7662
        }
      ]
    },
    {
      "kind": "model",
      "label": "Motion and haptic feedback",
      "text": "A three-degree-of-freedom motion platform, force-feedback steering wheel and instrumented pedals are coupled to the vehicle model. The simulated vehicle state drives the platform, steering feedback and visual scene. Exercise parameters and feedback settings can be adjusted for the selected protocol.",
      "model": "/models/DriveSim_seat_blocco2.glb",
      "side": "right"
    },
    {
      "kind": "model",
      "label": "Session measurements",
      "text": "The system records time-stamped control inputs, vehicle states and task events. Automated session reports summarise exergame performance and driving behaviour, including speed, trajectory control and responses to events in the virtual environment.",
      "model": "/models/DriveSim_fiat_blocco3.glb",
      "side": "left",
      "modelOptions": {
        "build": false,
        "anim": "drive",
        "view": "top",
        "size": 1.2
      }
    }
  ]}
  description={"DriveSim is a compact dynamic driving simulator developed for rehabilitation-oriented research. It combines a motion platform, haptic steering, instrumented pedals and a virtual urban environment. Configurable exergames and traffic scenarios provide tasks with recorded performance measures. Experimental evaluation has focused on healthy participants; the research examines task design, the interpretation of session metrics and the integration of visual and physical feedback."}
  publications={publications}
  funding={"Supported by the Italian Ministry of University and Research through the complementary actions to the National Recovery and Resilience Plan, 'Fit4MedRob — Fit for Medical Robotics' (grant PNC0000007)."}
  prevActivity={{
    "label": "Balance Platform Simulator",
    "href": "/activities/balance-platform-simulator/"
  }}
  nextActivity={{
    "label": "AHBI",
    "href": "/activities/ahbi/"
  }}
/>

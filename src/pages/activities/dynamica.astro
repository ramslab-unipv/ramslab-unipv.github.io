---
import ProjectStoryLayout from '../../components/ProjectStoryLayout.astro';
import { getProjectPublications } from '../../lib/publications';

const publications = await getProjectPublications('dynamica');
const v = (name: string) => ({ video: `/videos/scroll/dynamica-${name}.mp4`, poster: `/videos/scroll/dynamica-${name}-poster.jpg` });
---

<ProjectStoryLayout
  title="DYNAMICA"
  subtitle="Language-guided robot programming and mixed-reality interaction"
  accentColor="#3b82f6"
  activity="dynamica"
  cover={{ ...v('cover'), alt: 'An operator wearing an AR headset works beside a collaborative robot.' }}
  vision={"DYNAMICA investigates how language, visual perception and operator review can support programming and coordination in collaborative robotics."}
  intro={[
    'The programming framework combines natural-language instructions with RGB-D observations of the workspace. Object references are converted into manipulation poses in the robot reference frame.',
    'A mixed-reality interface displays these poses together with a digital model of the robot. The operator can inspect and correct the proposed actions before authorising physical execution.',
  ]}
  chapters={[
    {
      kind: 'media',
      label: 'Programming and operator review',
      text: 'Language and vision modules identify the requested objects and propose manipulation poses. These poses are displayed as overlays in the mixed-reality headset. Hand tracking allows the operator to adjust their position and orientation, then review the simulated task before execution.',
      media: [{ ...v('programming'), alt: 'Manipulation poses displayed in mixed reality and adjusted through hand tracking.', ratio: 16 / 9 }],
    },
    {
      kind: 'media',
      label: 'Task allocation',
      text: 'The task-allocation module assigns operations to the person and the robot on a cycle-by-cycle basis using execution-time optimisation. Visual instructions guide the operator through the manual operations assigned within the shared workflow.',
      media: [{ ...v('allocation'), alt: 'The operator follows AR instructions while the robot executes its own tasks.', ratio: 16 / 9 }],
    },
    {
      kind: 'statement',
      lead: 'Operator verification is part of the programming workflow.',
      text: 'The interface allows the person to check object selection, manipulation poses and the simulated sequence before authorising the robot to act.',
    },
    {
      kind: 'media',
      label: 'Workspace monitoring',
      text: 'A four-camera markerless system reconstructs the positions of people in the workspace. These measurements inform robot speed modulation within the research implementation of Speed and Separation Monitoring (SSM).',
      media: [{ ...v('safety'), alt: 'Markerless pose estimation tracking people in the shared workspace.', ratio: 16 / 9 }],
    },
  ]}
  description="DYNAMICA studies programming and coordination methods for collaborative robotic tasks. The framework combines language interpretation, visual grounding and mixed-reality operator review before robot execution. Additional modules address task allocation and camera-based workspace monitoring. The research examines how these components can support the definition, inspection and execution of shared human–robot workflows."
  publications={publications}
  funding={`Funded by the European Union — NextGenerationEU under the Italian National Recovery and Resilience Plan (PNRR), Mission 4 "Istruzione e Ricerca", Component 2, Investment 1.1, PRIN 2022 (D.D. n. 104 of 2 February 2022). Project: "DYNamic Assessment and Mitigation of the Impact of Collaborative Applications (DYNAMICA)"; grant 2022XXH9JZ_002; CUP I53D23001930006.`}
  team={[
    { name: 'Università Politecnica delle Marche', role: 'Partner' },
    { name: 'Università degli Studi di Padova', role: 'Partner' },
  ]}
  prevActivity={{ label: 'DEMETRA', href: '/activities/demetra/' }}
  nextActivity={{ label: 'Airflow Dynamics', href: '/activities/air-flow-dynamic/' }}
/>

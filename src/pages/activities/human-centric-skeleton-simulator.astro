---
import ProjectStoryLayout from '../../components/ProjectStoryLayout.astro';
import { getProjectPublications } from '../../lib/publications';

const publications = await getProjectPublications('human-centric-skeleton-simulator');
---

<ProjectStoryLayout
  title={"Human-in-the-Loop Skeleton Simulator"}
  accentColor="#0ea5e9"
  activity="human-centric-skeleton-simulator"
  cover={{
    "video": "/videos/scroll/skeleton-world.mp4",
    "poster": "/videos/scroll/skeleton-world-poster.jpg",
    "alt": "First-person view down the virtual skeleton track."
  }}
  vision={"The simulator reproduces a skeleton descent in the laboratory while measuring the athlete's movements and interaction forces."}
  chapters={[
    {
      "kind": "media",
      "label": "Laboratory simulation",
      "text": "The athlete lies on a physical sled mounted on a motion platform and views a virtual track. A sled dynamics model determines the simulated descent, providing a laboratory setting for investigating steering-related actions.",
      "media": [
        {
          "image": "/images/projects/Sim_skeleton.png",
          "alt": "An athlete wearing a VR headset lies on the skeleton sled mounted on the motion platform.",
          "ratio": 1.3346
        }
      ]
    },
    {
      "kind": "media",
      "label": "Motion and force measurements",
      "text": "Markerless cameras measure body movement while load cells record the athlete's interaction with the sled. The measurements support analysis of steering-related actions. Pose-estimation methods are evaluated against optical motion capture to examine their performance in the prone posture and under equipment occlusions.",
      "media": [
        {
          "video": "/videos/scroll/skeleton-capture.mp4",
          "poster": "/videos/scroll/skeleton-capture-poster.jpg",
          "alt": "Animation: the athlete's tracked body points plotted in 3D during a run.",
          "ratio": 1.0938
        }
      ]
    },
    {
      "kind": "model",
      "label": "Virtual track geometry",
      "text": "GPS and satellite data are used to reconstruct track geometry for the virtual environment. The system also supports custom tracks, allowing researchers and coaches to define courses for a selected simulation task.",
      "model": "/models/Cortina_track.glb",
      "side": "right",
      "modelOptions": {
        "view": "top"
      }
    }
  ]}
  description={"This research platform combines a physical skeleton sled, a motion platform, a sled dynamics model and a virtual track. Camera-based body tracking and load-cell measurements are used to study athlete–sled interaction during simulated descents. Research includes evaluation of steering-related motion measurements and adaptation of pose-estimation models to the posture and occlusions encountered in the simulator."}
  publications={publications}
  funding={"The study of markerless motion measurement in the simulator is supported by the Italian Ministry of University and Research (MUR) through the complementary actions to the National Recovery and Resilience Plan (NRRP), \"Fit4MedRob — Fit for Medical Robotics\" (grant PNC0000007)."}
  prevActivity={{
    "label": "Robotic Liquid Handling",
    "href": "/activities/robotic-liquid-handling/"
  }}
  nextActivity={{
    "label": "Real-time 3D Human Pose Estimation",
    "href": "/activities/3d-human-poses-estimation/"
  }}
/>

---
import ProjectStoryLayout from '../../components/ProjectStoryLayout.astro';
import { getProjectPublications } from '../../lib/publications';

const publications = await getProjectPublications('robotic-liquid-handling');
---

<ProjectStoryLayout
  title={"Robotic Liquid Handling"}
  accentColor="#f97316"
  activity="robotic-liquid-handling"
  cover={{
    "video": "/videos/scroll/liquid-world.mp4",
    "poster": "/videos/scroll/liquid-world-poster.jpg",
    "alt": "A robotic arm transferring a liquid container."
  }}
  vision={"The project investigates how measurements of liquid motion can support the design of robotic transport trajectories."}
  chapters={[
    {
      "kind": "media",
      "label": "Measuring the free surface",
      "text": "Acceleration of a liquid-filled container produces free-surface oscillations, or sloshing. A vision-based measurement system records the liquid response while an industrial robot moves the container along prescribed trajectories.",
      "media": [
        {
          "video": "/videos/projects/Media2.mp4",
          "alt": "Side view of the liquid free surface sloshing inside the container.",
          "ratio": 1.8276
        }
      ]
    },
    {
      "kind": "media",
      "label": "Experimental model assessment",
      "text": "The measured response is compared with an analytical mass–spring–damper model. Repeated robotic trials provide data for examining the predicted surface motion and identifying discrepancies during transient oscillations.",
      "media": [
        {
          "image": "/images/projects/Picture2_white.png",
          "alt": "Model of the liquid free surface: wave height η(x,t) in a container of length L filled to height h.",
          "ratio": 1.6013,
          "chart": true
        }
      ]
    },
    {
      "kind": "media",
      "label": "Trajectory design",
      "text": "A research objective is to use the measured dynamics when designing transport trajectories. Candidate objectives include limiting free-surface excursions during transfer and reducing residual oscillations at the destination.",
      "media": [
        {
          "image": "/images/projects/Picture3_white.png",
          "alt": "Sloshing height over time: the acquired slosh compared with the residuals model, within the sloshing limit.",
          "ratio": 1.6681,
          "chart": true
        }
      ]
    },
    {
      "kind": "media",
      "label": "Transport and mixing objectives",
      "text": "The project also considers whether prescribed container motions could produce controlled mixing. This is a research objective alongside the reduction of unwanted oscillations during transport.",
      "media": [
        {
          "video": "/videos/projects/Media1.mp4",
          "alt": "A robot moves a liquid-filled container during an experimental trial.",
          "ratio": 1.7778
        }
      ]
    },
    {
      "kind": "media",
      "label": "Adaptive methods under investigation",
      "text": "The longer-term aim is to estimate liquid–container dynamics from visual measurements and use them to adapt motion planning. The experimental measurement pipeline provides data for investigating this approach across specified operating conditions.",
      "media": [
        {
          "image": "/images/projects/Picture4.png",
          "alt": "A liquid container held in the robot’s end-effector.",
          "ratio": 1.0841
        }
      ]
    }
  ]}
  description={"This activity studies liquid motion during robotic handling. A vision-based system measures the free-surface response of a container moved by an industrial manipulator. Published work compares experimental measurements with an analytical sloshing model. The wider project aims to use such measurements for system identification and trajectory design, including the investigation of transport with reduced oscillations and controlled mixing."}
  publications={publications}
  funding={"Funded by MED4REPAIR — Smart advanced medical devices for tissue repair, under Regione Lombardia's 'Collabora e Innova' call, PR FESR 2021–2027 (project ID 6064179; R1.2024.0005575 of 27 November 2024)."}
  prevActivity={{
    "label": "Airflow Dynamics",
    "href": "/activities/air-flow-dynamic/"
  }}
  nextActivity={{
    "label": "Human-in-the-Loop Skeleton Simulator",
    "href": "/activities/human-centric-skeleton-simulator/"
  }}
/>
